# SPDX-License-Identifier: MIT
# OnePlus 13 (dodge, SM8750) fragment, merged on top of arm64 defconfig.
# The Pixel fragment (ARCH_EXYNOS, Exynos USB, s3c2410_wdt) does not apply.
# tools/dodge-try merges this. The initramfs carries no modules, so the
# loop's drivers are built in.

# Early display. This tree's FB_SIMPLE depends on !DRM_SIMPLEDRM, so the
# simple framebuffer is the DRM driver. ABL's simple-framebuffer node, if
# it leaves one, binds here. SYSFB_SIMPLEFB only marks an EFI framebuffer.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# USB gadget: CDC NCM and ACM, the same pair the cheetah initramfs brings up.
# defconfig leaves configfs modular; the ramdisk has no modules.
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
# Builds both dwc3-qcom (qcom,snps-dwc3) and dwc3-qcom-legacy (qcom,dwc3).
# This tree's sm8750.dtsi falls back to qcom,dwc3, so the legacy driver binds.
CONFIG_USB_DWC3_QCOM=y

# SM8750 USB PHYs. The HS PHY waits on the PMIC eUSB2 repeater, so that
# driver is built in too. The combo PHY cannot be built in while DRM or
# TYPEC is a module (drivers/phy/qualcomm/Kconfig).
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_TYPEC=y
# Both USB PHYs and UFS take their reference clock from the TCSR clock
# controller (TCSR_USB2/USB3/UFS_CLKREF_EN). defconfig builds it as a
# module, so without this the PHYs defer forever and no UDC appears.
CONFIG_SM_TCSRCC_8750=y

# pstore. There is no ramoops node in the dodge DTB yet (PLAN.md §5.1);
# the driver is built in so a later node does not need a module.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# QCOM_WDT has nothing to bind on this DTB (no qcom,apss-wdt node; stock's
# watchdog is an empty Gunyah node). Built in so a node added later arms
# at probe. It does not reset the phone until that node exists.
CONFIG_WATCHDOG=y
CONFIG_QCOM_WDT=y

# A hang that panics reboots. panic=10 is also on the image cmdline.
# Soft lockup and hung task are the cases with no watchdog.
CONFIG_PANIC_TIMEOUT=10
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y

# No CONFIG_DEVMEM. Dodge userspace does not read SoC registers.
# UFS host and its QMP PHY are built in so the ramdisk can see the
# disks. The init marks every disk read-only and does not mount.
# omamobile.ufs-probe on the cmdline only lists PARTNAME.
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y

# Reboot straight to fastboot. The reason byte is reboot-reason@48 in
# pmk8550's SPMI SDAM. The ramdisk loads no modules, so the cell, the
# nvmem reboot-mode driver and the PON driver are all built in.
# device/dodge/PLAN.md phase 3.5 gate 1.
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_POWER_RESET_QCOM_PON=y

# S3910 touch on spi4. A module, so it is not in the ramdisk and it
# does not come up until it is loaded. The panel driver stays off.
CONFIG_TOUCHSCREEN_SYNA_TCM2=m

# Speaker audio: the FastRPC audio heap, the MI2S DAI format and the
# sc8280xp machine driver are patched on omamobile-dodge; the Awinic
# 0x2308 amplifier driver is new there. Modules, loaded in order by
# device/dodge/audio/audio-bringup.sh.
CONFIG_QCOM_FASTRPC=m
CONFIG_SND_SOC_QDSP6_APM_LPASS_DAI=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_AW882308=m
