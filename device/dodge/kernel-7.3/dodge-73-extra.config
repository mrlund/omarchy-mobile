# 7.3 only: the Gunyah hypervisor watchdog (registered by qcom_scm when no
# DT watchdog node is available). The initramfs feeds it, and systemd's
# RuntimeWatchdogSec takes over after switch_root.
CONFIG_WATCHDOG=y
CONFIG_GUNYAH_WATCHDOG=y
CONFIG_HAVE_ARM_SMCCC_DISCOVERY=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
# iptables/ip6tables legacy tables are behind this switch since 6.17
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_NETMAP=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
# Wi-Fi (peach, PCI 0x110e) on the wifi7 QCC2072 HAL, patches 0036-0050.
CONFIG_ATH12K=m
