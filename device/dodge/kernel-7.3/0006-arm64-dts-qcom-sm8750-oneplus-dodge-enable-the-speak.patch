From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Tue, 20 Oct 2026 11:37:22 +0200
Subject: [PATCH 06/66] arm64: dts: qcom: sm8750-oneplus-dodge: enable the
 speaker amplifier bus

The two Awinic speaker amplifiers sit on hub I2C4 at 0x34 and 0x35.
Enable the bus; the amplifiers bind from userspace during bring-up.
---
 arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index cd8ce9ba2..80a679b56 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -1301,6 +1301,15 @@ &mdss_dsi0_phy {
 	status = "okay";
 };
 
+/*
+ * The two speaker amplifiers (Awinic, product id 0x2308) sit at 0x34 and
+ * 0x35, resets on TLMM 2 and 164, as in stock's live DT. Bus only for
+ * now: the amplifier driver binds through new_device during bring-up.
+ */
+&i2c_hub_4 {
+	status = "okay";
+};
+
 &i2c_hub_3 {
     status = "okay";
     bq28z610: fuel-gauge@55 {
