From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Sat, 24 Oct 2026 17:21:22 +0200
Subject: [PATCH 65/66] arm64: dts: qcom: sm8750-oneplus-dodge: enable Adreno
 830 GPU

Zap shader from the stock (OEM-signed) firmware, installed on the phone
as qcom/sm8750/OnePlus/gen80000_zap.mbn.
---
 arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index db2103900..dd2c51069 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -1217,6 +1217,14 @@ &remoteproc_mpss {
 	status = "okay";
 };
 
+&gpu {
+	status = "okay";
+};
+
+&gpu_zap_shader {
+	firmware-name = "qcom/sm8750/OnePlus/gen80000_zap.mbn";
+};
+
 &i2c3 {
 	status = "okay";
 
