+
+	status = "okay";
+};
+
+&tlmm {
+	/* reserved for secure world */
+	gpio-reserved-ranges = <36 4>, <74 1>;
+
+	ts_reset_active: ts_reset_active-state {
+		pins = "gpio161";
+		function = "gpio";
+		bias-disable;
+		output-low;
+		drive-strength = <8>;
+	};
+
+	ts_int_active: ts_int_active-state {
+		pins = "gpio162";
+		function = "gpio";
+		bias-pull-up;
+		drive-strength = <8>;
+		input-enable;
+	};
+
+	ts_reset_suspend: ts_reset_suspend-state {
+		pins = "gpio161";
+		function = "gpio";
+		bias-pull-down;
+		drive-strength = <2>;
+	};
+
+	ts_int_suspend: ts_int_suspend-state {
+		pins = "gpio162";
+		function = "gpio";
+		bias-pull-down;
+		drive-strength = <2>;
+	};
+	
+	hall_interrupt_input: hall-interrupt-input-state {
+		pins = "gpio97";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	bt_default: bt-default-state {
+		sw-ctrl-pins {
+			pins = "gpio18";
+			function = "gpio";
+			bias-pull-down;
+		};
+	};
+
+	disp0_reset_n_active: disp0-reset-n-active-state {
+		pins = "gpio98";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	disp0_reset_n_suspend: disp0-reset-n-suspend-state {
+		pins = "gpio98";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	mdp_vsync_active: mdp-vsync-active-state {
+		pins = "gpio86";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	mdp_vsync_suspend: mdp-vsync-suspend-state {
+		pins = "gpio86";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	wlan_en: wlan-en-state {
+		pins = "gpio16";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-down;
+	};
+};
