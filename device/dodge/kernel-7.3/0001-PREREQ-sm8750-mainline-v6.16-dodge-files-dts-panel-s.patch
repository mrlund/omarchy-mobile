+/delete-node/ &{/reserved-memory};
+
+/ {
+	model = "OnePlus 13";
+	compatible = "OnePlus,13", "qcom,sm8750";
+	chassis-type = "handset";
+
+	aliases {
+		serial0 = &uart7;
+	};
+
+	memory {
+		ddr_device_type = <0x08>;
+		device_type = "memory";
+		reg = <0x00 0x81960000 0x00 0xa0000 0x00 0x81a40000 0x00 0x1c0000 0x00 0x81cf4000 0x00 0xc000 0x00 0x82460000 0x00 0x40000 0x00 0xd8600000 0x00 0x00 0x00 0xe3720000 0x00 0x1c0e0000 0x08 0x80000000 0x00 0x2f700000 0x08 0xb0000000 0x00 0x52c0000 0x0a 0x00 0x02 0x00 0x08 0xc0000000 0x01 0x40000000 0x00 0x82800000 0x00 0x2200000 0x00 0x89d80000 0x00 0x1c80000 0x00 0xa4880000 0x00 0x13780000 0x00 0xb81c0000 0x00 0x1cc63000 0x00 0xd5100000 0x00 0x2f00000>;
+	};
+
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+	};
+	
+	pmic-glink {
+		compatible = "qcom,sm8750-pmic-glink",
+			     "qcom,sm8550-pmic-glink",
+			     "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		orientation-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>; // qrd value
+
+		connector@0 {
+			compatible = "usb-c-connector";
+			reg = <0>;
+
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					pmic_glink_hs_in: endpoint {
+						remote-endpoint = <&usb_dwc3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					pmic_glink_ss_in: endpoint {
+						remote-endpoint = <&usb_dp_qmpphy_out>;
+					};
+				};
+			};
+		};
+	};
+
+	bat: battery {
+		compatible = "simple-battery";
+		voltage-min-design-microvolt = <6300000>;
+	};
+
+	clocks {
