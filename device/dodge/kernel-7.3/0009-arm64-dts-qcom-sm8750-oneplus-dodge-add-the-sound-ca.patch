From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Tue, 20 Oct 2026 11:56:34 +0200
Subject: [PATCH 09/21] arm64: dts: qcom: sm8750-oneplus-dodge: add the sound
 card

Secondary MI2S on q6apm to the two speaker amplifiers, with the i2s1
pins in their active state.
---
 .../boot/dts/qcom/sm8750-oneplus-dodge.dts    | 55 +++++++++++++++++++
 1 file changed, 55 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index 6d405cdf3..1ae0e7358 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -39,6 +39,30 @@ / {
 		      <0x100027f 0x20000>;
 	qcom,board-id = <0x40008 0x00>;
 
+	sound {
+		compatible = "qcom,sm8750-sndcard";
+		model = "OnePlus-dodge";
+
+		pinctrl-0 = <&i2s1_active>;
+		pinctrl-names = "default";
+
+		speaker-dai-link {
+			link-name = "Speaker Playback";
+
+			cpu {
+				sound-dai = <&q6apmbedai SECONDARY_MI2S_RX>;
+			};
+
+			codec {
+				sound-dai = <&speaker_left>, <&speaker_right>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+
 	aliases {
 		serial0 = &uart7;
 	};
@@ -1094,6 +1118,37 @@ &tlmm {
 	/* reserved for secure world */
 	gpio-reserved-ranges = <36 4>, <74 1>;
 
+	/* Secondary MI2S to the speaker amplifiers; data1 is their input. */
+	i2s1_active: i2s1-active-state {
+		sck-pins {
+			pins = "gpio121";
+			function = "i2s1_sck";
+			drive-strength = <4>;
+			bias-disable;
+		};
+
+		data0-pins {
+			pins = "gpio122";
+			function = "i2s1_data0";
+			drive-strength = <4>;
+			bias-disable;
+		};
+
+		ws-pins {
+			pins = "gpio123";
+			function = "i2s1_ws";
+			drive-strength = <4>;
+			bias-disable;
+		};
+
+		data1-pins {
+			pins = "gpio124";
+			function = "i2s1_data1";
+			drive-strength = <4>;
+			bias-disable;
+		};
+	};
+
 	ts_reset_active: ts_reset_active-state {
 		pins = "gpio161";
 		function = "gpio";
-- 
2.55.0

