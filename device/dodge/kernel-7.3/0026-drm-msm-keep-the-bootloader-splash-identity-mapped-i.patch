From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Wed, 21 Oct 2026 16:45:41 +0200
Subject: [PATCH 26/27] drm/msm: keep the bootloader splash identity-mapped in
 the display domain (dodge)

---
 drivers/gpu/drm/msm/msm_iommu.c | 33 +++++++++++++++++++++++++++++++++
 drivers/gpu/drm/msm/msm_kms.c   |  7 ++++++-
 drivers/gpu/drm/msm/msm_mmu.h   |  1 +
 3 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/msm_iommu.c b/drivers/gpu/drm/msm/msm_iommu.c
index da6782fca..71aa988de 100644
--- a/drivers/gpu/drm/msm/msm_iommu.c
+++ b/drivers/gpu/drm/msm/msm_iommu.c
@@ -7,6 +7,8 @@
 #include <linux/adreno-smmu-priv.h>
 #include <linux/io-pgtable.h>
 #include <linux/kmemleak.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
 
 #if defined(CONFIG_ARM_DMA_USE_IOMMU)
 #include <asm/dma-iommu.h>
@@ -796,6 +798,37 @@ struct msm_mmu *msm_iommu_disp_new(struct device *dev, unsigned long quirks)
 	return mmu;
 }
 
+/*
+ * The bootloader can leave the display engine fetching its splash buffer.
+ * The default DMA domain carries that region as an identity map
+ * (iommu-addresses on the reserved-memory node), but msm attaches its own
+ * paging domain, so the leftover fetches fault. On dodge (SM8750) a fault
+ * at the end of the splash frame leaves the MDP AXI path wedged, and the
+ * next DSI command DMA times out (-110). Keep the region readable at the
+ * same address in our domain. Returns the IOVA start (the VM must stay
+ * below it), or 0 if there is no such region.
+ */
+u64 msm_iommu_disp_map_splash(struct msm_mmu *mmu, struct device *dev)
+{
+	struct msm_iommu *iommu = to_msm_iommu(mmu);
+	struct device_node *np;
+	struct resource r;
+	int i, ret;
+
+	for (i = 0; (np = of_parse_phandle(dev->of_node, "memory-region", i)); i++) {
+		if (of_property_present(np, "iommu-addresses") &&
+		    !of_address_to_resource(np, 0, &r)) {
+			of_node_put(np);
+			ret = iommu_map(iommu->domain, r.start, r.start,
+					resource_size(&r), IOMMU_READ, GFP_KERNEL);
+			dev_info(dev, "splash %pR identity-mapped read-only: %d\n", &r, ret);
+			return ret ? 0 : r.start;
+		}
+		of_node_put(np);
+	}
+	return 0;
+}
+
 struct msm_mmu *msm_iommu_gpu_new(struct device *dev, struct msm_gpu *gpu, unsigned long quirks)
 {
 	struct adreno_smmu_priv *adreno_smmu = dev_get_drvdata(dev);
diff --git a/drivers/gpu/drm/msm/msm_kms.c b/drivers/gpu/drm/msm/msm_kms.c
index e5d0ea629..ac77a0dfa 100644
--- a/drivers/gpu/drm/msm/msm_kms.c
+++ b/drivers/gpu/drm/msm/msm_kms.c
@@ -185,6 +185,7 @@ struct drm_gpuvm *msm_kms_init_vm(struct drm_device *dev, struct device *mdss_de
 	struct msm_drm_private *priv = dev->dev_private;
 	struct msm_kms *kms = priv->kms;
 	struct device *iommu_dev;
+	u64 splash, va_end = 0x100000000ULL;
 
 	/*
 	 * IOMMUs can be a part of MDSS device tree binding, or the
@@ -203,8 +204,12 @@ struct drm_gpuvm *msm_kms_init_vm(struct drm_device *dev, struct device *mdss_de
 	if (IS_ERR(mmu))
 		return ERR_CAST(mmu);
 
+	splash = msm_iommu_disp_map_splash(mmu, iommu_dev);
+	if (splash > 0x1000 && splash < va_end)
+		va_end = splash;
+
 	vm = msm_gem_vm_create(dev, mmu, "mdp_kms",
-			       0x1000, 0x100000000 - 0x1000, true);
+			       0x1000, va_end - 0x1000, true);
 	if (IS_ERR(vm)) {
 		dev_err(mdp_dev, "vm create, error %pe\n", vm);
 		mmu->funcs->destroy(mmu);
diff --git a/drivers/gpu/drm/msm/msm_mmu.h b/drivers/gpu/drm/msm/msm_mmu.h
index 8915662fb..7425a2b9d 100644
--- a/drivers/gpu/drm/msm/msm_mmu.h
+++ b/drivers/gpu/drm/msm/msm_mmu.h
@@ -77,6 +77,7 @@ static inline void msm_mmu_init(struct msm_mmu *mmu, struct device *dev,
 struct msm_mmu *msm_iommu_new(struct device *dev, unsigned long quirks);
 struct msm_mmu *msm_iommu_gpu_new(struct device *dev, struct msm_gpu *gpu, unsigned long quirks);
 struct msm_mmu *msm_iommu_disp_new(struct device *dev, unsigned long quirks);
+u64 msm_iommu_disp_map_splash(struct msm_mmu *mmu, struct device *dev);
 
 static inline void msm_mmu_set_fault_handler(struct msm_mmu *mmu, void *arg,
 		int (*handler)(void *arg, unsigned long iova, int flags, void *data))
-- 
