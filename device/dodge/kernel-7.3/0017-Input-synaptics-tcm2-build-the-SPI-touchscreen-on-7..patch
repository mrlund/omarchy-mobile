From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Wed, 21 Oct 2026 14:51:13 +0200
Subject: [PATCH 17/66] Input: synaptics-tcm2: build the SPI touchscreen on 7.3

Port of dodge 0004 (SPI dependency, module name synaptics_tcm2), and
replace the removed <linux/of_gpio.h> with a gpiod lookup that hands
back the legacy GPIO number.
---
 drivers/input/touchscreen/Kconfig         | 12 ++++----
 drivers/input/touchscreen/Makefile        |  6 ++--
 drivers/input/touchscreen/syna_tcm2.h     |  3 +-
 drivers/input/touchscreen/syna_tcm2_spi.c | 35 +++++++++++++++++++++--
 4 files changed, 43 insertions(+), 13 deletions(-)

diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index d9b408851..e6eb1f498 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1430,15 +1430,15 @@ config TOUCHSCREEN_HIMAX_HX83112B
 	  module will be called himax_hx83112b.
 
 config TOUCHSCREEN_SYNA_TCM2
-	tristate "Synaptics TCM touchscreen"
-	depends on I2C
-	select REGMAP_I2C
+	tristate "Synaptics TCM touchscreen over SPI"
+	depends on SPI
 	help
-	  Say Y here if you have a Synaptics TCM touchscreen connected
-	  to your system.
+	  Say Y here if you have a Synaptics TCM touchscreen on SPI,
+	  such as the S3910 (compatible "synaptics,tcm-spi-hbp").
 
 	  If unsure, say N.
 
-	  To compile this driver as a module, choose M here.
+	  To compile this driver as a module, choose M here: the
+	  module will be called synaptics_tcm2.
 
 endif
diff --git a/drivers/input/touchscreen/Makefile b/drivers/input/touchscreen/Makefile
index 8f9f3f730..94c3167a4 100644
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -120,6 +120,6 @@ obj-$(CONFIG_TOUCHSCREEN_IQS5XX)	+= iqs5xx.o
 obj-$(CONFIG_TOUCHSCREEN_IQS7211)	+= iqs7211.o
 obj-$(CONFIG_TOUCHSCREEN_ZINITIX)	+= zinitix.o
 obj-$(CONFIG_TOUCHSCREEN_HIMAX_HX83112B)	+= himax_hx83112b.o
-syna_tcm2-y := syna_tcm2.o
-syna_tcm2-y += syna_tcm2_spi.o
-obj-$(CONFIG_TOUCHSCREEN_SYNA_TCM2) += syna_tcm2.o
+# syna_tcm2.c cannot be both the member and the module name.
+obj-$(CONFIG_TOUCHSCREEN_SYNA_TCM2) += synaptics_tcm2.o
+synaptics_tcm2-y := syna_tcm2.o syna_tcm2_spi.o
diff --git a/drivers/input/touchscreen/syna_tcm2.h b/drivers/input/touchscreen/syna_tcm2.h
index 2294f1e64..18bd25bd3 100644
--- a/drivers/input/touchscreen/syna_tcm2.h
+++ b/drivers/input/touchscreen/syna_tcm2.h
@@ -39,7 +39,8 @@
 #include <linux/input.h>
 #include <linux/delay.h>
 #include <linux/gpio.h>
-#include <linux/of_gpio.h>
+#include <linux/gpio/consumer.h>
+#include <linux/of.h>
 #include <linux/interrupt.h>
 #include <linux/init.h>
 #include <linux/major.h>
diff --git a/drivers/input/touchscreen/syna_tcm2_spi.c b/drivers/input/touchscreen/syna_tcm2_spi.c
index 676f0bda4..e1887ee3c 100644
--- a/drivers/input/touchscreen/syna_tcm2_spi.c
+++ b/drivers/input/touchscreen/syna_tcm2_spi.c
@@ -33,6 +33,35 @@
 #include "syna_tcm2.h"
 #include <linux/pinctrl/consumer.h>
 
+/*
+ * <linux/of_gpio.h> is gone. The driver still uses legacy GPIO numbers,
+ * so look the line up through gpiod and hand back its number. The
+ * descriptor is released again so the later gpio_request() succeeds.
+ */
+static int syna_of_get_named_gpio(struct device_node *np, const char *prop,
+				  int index)
+{
+	char con_id[48];
+	struct gpio_desc *desc;
+	size_t n = strlen(prop);
+	int gpio;
+
+	if (n > 5 && !strcmp(prop + n - 5, "-gpio"))
+		n -= 5;
+	if (n >= sizeof(con_id))
+		return -EINVAL;
+	memcpy(con_id, prop, n);
+	con_id[n] = '\0';
+
+	desc = fwnode_gpiod_get_index(of_fwnode_handle(np), con_id, index,
+				      GPIOD_ASIS, "syna_tcm2");
+	if (IS_ERR(desc))
+		return PTR_ERR(desc);
+	gpio = desc_to_gpio(desc);
+	gpiod_put(desc);
+	return gpio;
+}
+
 #define SPI_MODULE_NAME "synaptics_tcm_spi"
 
 static unsigned char *rx_buf;
@@ -333,7 +362,7 @@ static int syna_spi_parse_dt(struct syna_hw_interface *hw_if, struct device *dev
 
 	prop = of_find_property(np, "synaptics,irq-gpio", NULL);
 	if (prop && prop->length) {
-		attn->irq_gpio = of_get_named_gpio(np, "synaptics,irq-gpio", 0);
+		attn->irq_gpio = syna_of_get_named_gpio(np, "synaptics,irq-gpio", 0);
 	} else {
 		attn->irq_gpio = -1;
 	}
@@ -343,7 +372,7 @@ static int syna_spi_parse_dt(struct syna_hw_interface *hw_if, struct device *dev
 
 	prop = of_find_property(np, "synaptics,avdd-gpio", NULL);
 	if (prop && prop->length) {
-		pwr->avdd_gpio = of_get_named_gpio(np, "synaptics,avdd-gpio", 0);
+		pwr->avdd_gpio = syna_of_get_named_gpio(np, "synaptics,avdd-gpio", 0);
 	} else {
 		pwr->avdd_gpio = -1;
 	}
@@ -353,7 +382,7 @@ static int syna_spi_parse_dt(struct syna_hw_interface *hw_if, struct device *dev
 
 	prop = of_find_property(np, "synaptics,reset-gpio", NULL);
 	if (prop && prop->length) {
-		rst->reset_gpio = of_get_named_gpio(np, "synaptics,reset-gpio", 0);
+		rst->reset_gpio = syna_of_get_named_gpio(np, "synaptics,reset-gpio", 0);
 	} else {
 		rst->reset_gpio = -1;
 	}
