From 9f87b11441db1b464a40ef484a9b432b3c1b5dc4 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Mon, 26 Oct 2026 13:50:19 +0100
Subject: [PATCH 74/74] arm64: dts: qcom: sm8750: IPA: use 3-cell GIC interrupt
 specifiers

The SM8750 GIC has #interrupt-cells = <3>; the node was copied from SM8650
(4 cells), so the trailing 0 of the first entry was parsed as the phandle
of the gsi interrupt and the probe failed with -ENXIO (IRQ gsi not found).

Signed-off-by: Martin Lund <mrlund@hotmail.com>
---
 arch/arm64/boot/dts/qcom/sm8750.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8750.dtsi b/arch/arm64/boot/dts/qcom/sm8750.dtsi
index 07baaccda..77db15e79 100644
--- a/arch/arm64/boot/dts/qcom/sm8750.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8750.dtsi
@@ -2194,8 +2194,8 @@ ipa: ipa@3f40000 {
 				    "ipa-shared",
 				    "gsi";
 
-			interrupts-extended = <&intc GIC_SPI 655 IRQ_TYPE_EDGE_RISING 0>,
-					      <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH 0>,
+			interrupts-extended = <&intc GIC_SPI 655 IRQ_TYPE_EDGE_RISING>,
+					      <&intc GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH>,
 					      <&ipa_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
 					      <&ipa_smp2p_in 1 IRQ_TYPE_EDGE_RISING>;
 			interrupt-names = "ipa",
-- 
2.56.0

