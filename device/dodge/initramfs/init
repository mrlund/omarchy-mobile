#!/bin/sh
# SPDX-License-Identifier: MIT
# First-light init for the OnePlus 13 (dodge). USB networking and ssh.
# Host side: the phone appears as a USB network adapter; ssh root@172.16.42.1
#
# Taken from device/cheetah/initramfs/init with the gs201 parts removed:
# no devmem, no DECON trigger write, no DPP/watchdog register reads.
# The Arch switch_root is not here. This ramdisk keeps every disk
# read-only. It logs which single partition it would later allow
# (PLAN.md phase 3.5 gate 3) and does not make that partition writable.

export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config
mount -t tmpfs tmpfs /run

# Every SCSI disk read-only, before anything else. A built-in host
# enumerates disks before this runs. Nothing mounts them. This pass,
# and the loop below, mark every one read-only, userdata included.
# The allowlist further down only logs. It never calls setrw.
ufs_ro_log() { echo "omamobile: ufs-ro: $*" > /dev/kmsg; }
mkdir -p /run/ufs-ro
ufs_partname() { sed -n 's/^PARTNAME=//p' "$1/uevent" 2>/dev/null; }
ufs_ro_pass() {
  local s ro name part
  for s in /sys/block/sd* /sys/block/sd*/sd*; do
    [ -r "$s/ro" ] || continue
    name=${s##*/}
    [ -e "/run/ufs-ro/$name" ] && continue
    [ -b "/dev/$name" ] || continue
    part=$(ufs_partname "$s")
    blockdev --setro "/dev/$name"
    read -r ro < "$s/ro"
    if [ "$ro" = 1 ]; then
      : > "/run/ufs-ro/$name"
      ufs_ro_log "/dev/$name${part:+ ($part)} set read-only"
    elif [ ! -e "/run/ufs-ro/$name.failed" ]; then
      : > "/run/ufs-ro/$name.failed"
      ufs_ro_log "FAILED to set /dev/$name read-only"
      echo "omamobile: WARNING: /dev/$name is NOT read-only" > /dev/tty0 2>/dev/null
    fi
  done
}
ufs_ro_pass
( while true; do ufs_ro_pass; sleep 0.2 2>/dev/null || sleep 1; done ) &
ufs_ro_log "guard running, no writable partitions (pid $!)"

hostname omamobile

SCREEN=/dev/tty0
say() { echo "omamobile: $*" | tee /dev/kmsg > $SCREEN 2>/dev/null; }

say "first light on $(cat /proc/sys/kernel/osrelease)"

# Feed /dev/watchdog only if a driver bound. Opening the device arms it.
# On the current dodge DTB nothing binds (PLAN.md §5.1): say so once.
# A hang after a successful open stops these writes and the watchdog
# resets the phone. Do not write 'V': that is the magic close.
(
  wd=""
  i=0
  while [ "$i" -lt 10 ]; do
    if [ -c /dev/watchdog0 ]; then
      wd=/dev/watchdog0
      break
    fi
    if [ -c /dev/watchdog ]; then
      wd=/dev/watchdog
      break
    fi
    i=$((i + 1))
    sleep 1
  done
  if [ -z "$wd" ]; then
    echo "omamobile: watchdog: no /dev/watchdog; a hang waits for a human" > /dev/kmsg
    exit 0
  fi
  exec 3>"$wd" || {
    echo "omamobile: watchdog: could not open $wd" > /dev/kmsg
    exit 0
  }
  echo "omamobile: watchdog: feeding $wd" > /dev/kmsg
  while true; do
    printf '\0' >&3 || exit 0
    sleep 2
  done
) &

# USB gadget: CDC NCM network + ACM serial console.
# 1d6b:0104 is the Linux Foundation multifunction gadget, so the host's
# cdc_ncm profile matches. It is not the phone's USB vendor id.
g=/sys/kernel/config/usb_gadget/g1
mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409
echo 0x1d6b > $g/idVendor
echo 0x0104 > $g/idProduct
echo "Omarchy Mobile" > $g/strings/0x409/manufacturer
echo "OnePlus 13" > $g/strings/0x409/product
echo "omamobile" > $g/strings/0x409/serialnumber
echo "NCM + ACM" > $g/configs/c.1/strings/0x409/configuration
mkdir -p $g/functions/ncm.usb0 $g/functions/acm.GS0
ln -s $g/functions/ncm.usb0 $g/configs/c.1/
ln -s $g/functions/acm.GS0 $g/configs/c.1/

udc=""
i=0
while [ "$i" -lt 30 ]; do
  udc=$(ls /sys/class/udc 2>/dev/null | head -1)
  [ -n "$udc" ] && break
  i=$((i + 1))
  sleep 1
done
if [ -n "$udc" ]; then
  echo "$udc" > $g/UDC && say "USB gadget up on $udc"
else
  say "no USB device controller found"
fi

ip link set lo up
i=0
while [ "$i" -lt 10 ]; do
  ip link show usb0 >/dev/null 2>&1 && break
  i=$((i + 1))
  sleep 1
done
# The laptop profile omamobile-phone is a static 172.16.42.2/24. This
# image does not run a DHCP server. Alpine's busybox has udhcpc only.
ip addr add 172.16.42.1/24 dev usb0 && ip link set usb0 up

mkdir -p /etc/dropbear
# -s: key login only. The image's authorized_keys is the developer's.
dropbear -R -E -s -p 22 2>/dev/null && say "ssh: root@172.16.42.1"
( while true; do setsid getty -n -l /bin/sh 115200 ttyGS0 vt100; sleep 1; done ) &

. /lib/omamobile-ufs.sh
if ! command -v ufs_userdata_decision >/dev/null 2>&1; then
  echo "omamobile: STOP userdata allowlist library missing" > /dev/kmsg
fi

# Log the one userdata partition. Do not make it writable. A count
# other than 1 is a stop. Wait until the partition list settles.
(
  last=-1
  i=0
  n=0
  while [ "$i" -lt 30 ]; do
    n=$(ls -d /sys/block/sd*/sd* 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] && [ "$n" = "$last" ] && break
    last=$n
    i=$((i + 1))
    sleep 1
  done
  ufs_ro_pass
  decision=$(ufs_userdata_decision)
  case $decision in
    allow\ *)
      dev=${decision#allow }
      ufs_ro_log "would allow $dev (userdata)"
      ;;
    *)
      ufs_ro_log "STOP userdata allowlist: $decision"
      ;;
  esac
  bad=0
  for s in /sys/block/sd* /sys/block/sd*/sd*; do
    [ -r "$s/ro" ] || continue
    read -r ro < "$s/ro"
    [ "$ro" = 1 ] && continue
    bad=$((bad + 1))
    ufs_ro_log "STOP /dev/${s##*/} is not read-only"
  done
  if [ "$bad" -eq 0 ]; then
    ufs_ro_log "allowlist check: every disk read-only"
  fi
) &

# Read-only disk list when the cmdline has omamobile.ufs-probe.
grep -q omamobile.ufs-probe /proc/cmdline && (
  last=-1
  i=0
  n=0
  while [ "$i" -lt 30 ]; do
    n=$(ls -d /sys/block/sd*/sd* 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] && [ "$n" = "$last" ] && break
    last=$n
    i=$((i + 1))
    sleep 1
  done
  ufs_ro_pass
  {
    echo "=== ufs-probe: $(ls -d /sys/block/sd* 2>/dev/null | wc -l) disks, $n partitions ==="
    cat /proc/partitions
    for d in /sys/block/sd*; do
      [ -e "$d" ] || { echo "no /sys/block/sd*"; break; }
      echo "${d##*/}: ro=$(cat "$d/ro") size=$(cat "$d/size")"
      for p in "$d"/sd*; do
        [ -e "$p/uevent" ] || continue
        echo "  ${p##*/} ro=$(cat "$p/ro") $(grep '^PARTNAME=' "$p/uevent")"
      done
    done
  } > /run/ufs-probe.txt 2>&1
  cat /run/ufs-probe.txt > $SCREEN 2>/dev/null
  while read -r line; do echo "omamobile: $line" > /dev/kmsg; done < /run/ufs-probe.txt
) &

say "ready"

# If the host never configures the gadget, panic so panic=10 reboots
# into OxygenOS. There is no watchdog to do it on this DTB.
(
  i=0
  while [ "$i" -lt 45 ]; do
    grep -qx configured /sys/class/udc/*/state 2>/dev/null && exit 0
    i=$((i + 1))
    sleep 1
  done
  {
    echo
    echo "=== USB never configured; dmesg follows ==="
    dmesg | grep -iE 'dwc3|phy|usb|udc|clk|error|fail' | tail -30
    echo "omamobile: USB never configured, panicking in 20 s"
  } > $SCREEN
  echo "omamobile: USB never configured, panicking in 20 s" > /dev/kmsg
  sleep 20
  sync
  echo 1 > /proc/sys/kernel/sysrq
  echo c > /proc/sysrq-trigger
) &

# PID 1 must never exit. setsid -c makes tty1 its controlling terminal.
while true; do
  setsid -c sh </dev/tty1 >/dev/tty1 2>&1
  sleep 1
done
