From 7026557340f2bf1590648270b8f652bacd6f96a1 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Fri, 23 Oct 2026 07:47:19 +0200
Subject: [PATCH] DIAG drm/panel: oneplus-dodge: on a failed first init, cycle
 the rails once (reset asserted, off 200 ms, on), reset, re-init

---
 .../gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c b/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
index a3bc2b0d6..2109dd1bc 100644
--- a/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
+++ b/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
@@ -303,6 +303,8 @@ static int panel_aa569_p_3_a0019_dsc_off(struct panel_aa569_p_3_a0019_dsc *ctx)
 	return dsi_ctx.accum_err;
 }
 
+static bool dodge_cycled;
+
 static int panel_aa569_p_3_a0019_dsc_prepare(struct drm_panel *panel)
 {
 	struct panel_aa569_p_3_a0019_dsc *ctx = to_panel_aa569_p_3_a0019_dsc(panel);
@@ -317,6 +319,24 @@ static int panel_aa569_p_3_a0019_dsc_prepare(struct drm_panel *panel)
 	panel_aa569_p_3_a0019_dsc_reset(ctx);
 
 	ret = panel_aa569_p_3_a0019_dsc_on(ctx);
+	/*
+	 * DIAG (dodge, round 15): the warm-boot drop. If the first init fails
+	 * (DSI cmd DMA -110), cycle the rails once (reset asserted, vci/vdd/
+	 * vddio off, 200 ms discharge, back on; enable/disable only, voltages
+	 * untouched), pulse reset and init again, to see if the panel is the
+	 * latch. Cold start is the only known cure so far.
+	 */
+	if (ret < 0 && !dodge_cycled) {
+		dodge_cycled = true;
+		dev_err(dev, "dodge-rail: first init failed %d, cycling the rails\n", ret);
+		panel_aa569_power_off(ctx, "rail-cycle");
+		ret = panel_aa569_power_on(ctx);
+		if (!ret) {
+			panel_aa569_p_3_a0019_dsc_reset(ctx);
+			ret = panel_aa569_p_3_a0019_dsc_on(ctx);
+		}
+		dev_err(dev, "dodge-rail: re-init after rail cycle: %d\n", ret);
+	}
 	if (ret < 0) {
 		dev_err(dev, "Failed to initialize panel: %d\n", ret);
 		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
-- 
2.56.0

