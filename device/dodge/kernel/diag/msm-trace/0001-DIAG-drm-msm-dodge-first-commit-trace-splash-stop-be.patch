+++ b/drivers/gpu/drm/msm/msm_mdss.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2018, The Linux Foundation
  */
 
+#include "dodge_trace.h"
 #include <linux/bitfield.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
@@ -464,7 +465,12 @@ static struct msm_mdss *msm_mdss_init(struct platform_device *pdev, bool is_mdp5
 	int ret;
 	int irq;
 
+	dodge_trace_map();
+	dodge_trace("mdss-prereset", 0);
+	dodge_stop_splash();
+	dodge_trace("mdss-stopped", 0);
 	ret = msm_mdss_reset(&pdev->dev);
+	dodge_trace("mdss-postreset", ret);
 	if (ret)
 		return ERR_PTR(ret);
 
