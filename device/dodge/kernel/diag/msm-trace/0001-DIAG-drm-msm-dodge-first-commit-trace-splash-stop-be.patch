index c604cf9b2..27e182ff0 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2015, The Linux Foundation. All rights reserved.
  */
 
+#include "dodge_trace.h"
 #include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/dma-mapping.h>
@@ -1432,11 +1433,13 @@ static int dsi_cmd_dma_tx(struct msm_dsi_host *msm_host, int len)
 
 	dsi_wait4video_eng_busy(msm_host);
 
+	dodge_trace("dsi-dma-pre", (u32)dma_base);
 	triggered = msm_dsi_manager_cmd_xfer_trigger(
 						msm_host->id, dma_base, len);
 	if (triggered) {
 		ret = wait_for_completion_timeout(&msm_host->dma_comp,
 					msecs_to_jiffies(200));
+		dodge_trace("dsi-dma-post", ret);
 		DBG("ret=%d", ret);
 		if (ret == 0)
 			ret = -ETIMEDOUT;
diff --git a/drivers/gpu/drm/msm/msm_iommu.c b/drivers/gpu/drm/msm/msm_iommu.c
index 739ce2c28..567b3428c 100644
--- a/drivers/gpu/drm/msm/msm_iommu.c
+++ b/drivers/gpu/drm/msm/msm_iommu.c
@@ -500,3 +500,15 @@ struct msm_mmu *msm_iommu_gpu_new(struct device *dev, struct msm_gpu *gpu, unsig
 
 	return mmu;
 }
+
+/*
+ * DIAG (dodge): map ABL's splash 1:1 read-only in msm's display domain,
+ * so a stale splash fetch that surfaces after the domain switch reads
+ * valid memory instead of faulting in CB9.
+ */
+int dodge_iommu_identity(struct msm_mmu *mmu, u64 base, size_t len)
+{
+	struct msm_iommu *iommu = to_msm_iommu(mmu);
+
+	return iommu_map(iommu->domain, base, base, len, IOMMU_READ, GFP_KERNEL);
+}
diff --git a/drivers/gpu/drm/msm/msm_kms.c b/drivers/gpu/drm/msm/msm_kms.c
index 35d5397e7..b611cdf9e 100644
--- a/drivers/gpu/drm/msm/msm_kms.c
+++ b/drivers/gpu/drm/msm/msm_kms.c
@@ -5,6 +5,7 @@
  * Author: Rob Clark <robdclark@gmail.com>
  */
 
+#include "dodge_trace.h"
 #include <linux/aperture.h>
 #include <linux/kthread.h>
 #include <linux/sched/mm.h>
@@ -168,6 +169,7 @@ static int msm_kms_fault_handler(void *arg, unsigned long iova, int flags, void
 {
 	struct msm_kms *kms = arg;
 
+	dodge_trace("iommu-fault", (u32)iova);
 	if (atomic_read(&kms->fault_snapshot_capture) == 0) {
 		msm_disp_snapshot_state(kms->dev);
 		atomic_inc(&kms->fault_snapshot_capture);
@@ -195,7 +197,9 @@ struct msm_gem_address_space *msm_kms_init_aspace(struct drm_device *dev)
 	else
 		iommu_dev = mdss_dev;
 
+	dodge_trace("attach-pre", 0);
 	mmu = msm_iommu_disp_new(iommu_dev, 0);
+	dodge_trace("attach-post", IS_ERR(mmu));
 	if (IS_ERR(mmu))
 		return ERR_CAST(mmu);
 
@@ -204,8 +208,15 @@ struct msm_gem_address_space *msm_kms_init_aspace(struct drm_device *dev)
 		return NULL;
 	}
 
+	{
+		/* DIAG (dodge): whole ABL splash reserved region (frame 1440x3168x4 + margin) */
+		int r = dodge_iommu_identity(mmu, 0xfc800000ULL, 0x2b00000);
+
+		pr_info("dodge-idmap: fc800000+2b00000 -> %d\n", r);
+	}
+	/* DIAG (dodge): keep GEM iovas below the identity-mapped splash */
 	aspace = msm_gem_address_space_create(mmu, "mdp_kms",
-		0x1000, 0x100000000 - 0x1000);
+		0x1000, 0xfc800000 - 0x1000);
 	if (IS_ERR(aspace)) {
 		dev_err(mdp_dev, "aspace create, error %pe\n", aspace);
 		mmu->funcs->destroy(mmu);
diff --git a/drivers/gpu/drm/msm/msm_mdss.c b/drivers/gpu/drm/msm/msm_mdss.c
index 8642ea8dc..0db34a839 100644
