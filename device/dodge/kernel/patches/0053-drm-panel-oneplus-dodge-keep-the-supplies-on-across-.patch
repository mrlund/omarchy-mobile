From 7327948f9d9bb61fcd7ad461533a0e19f3dd968b Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Thu, 22 Oct 2026 14:48:52 +0200
Subject: [PATCH] drm/panel: oneplus-dodge: keep the supplies on across
 unprepare, cut them only at shutdown and remove

---
 .../gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c | 24 +++++++++++++------
 1 file changed, 17 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c b/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
index 4a5258cfc..a3bc2b0d6 100644
--- a/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
+++ b/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
@@ -319,7 +319,7 @@ static int panel_aa569_p_3_a0019_dsc_prepare(struct drm_panel *panel)
 	ret = panel_aa569_p_3_a0019_dsc_on(ctx);
 	if (ret < 0) {
 		dev_err(dev, "Failed to initialize panel: %d\n", ret);
-		panel_aa569_power_off(ctx, "init failed");
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 		return ret;
 	}
 
@@ -353,7 +353,8 @@ static int panel_aa569_p_3_a0019_dsc_unprepare(struct drm_panel *panel)
 	if (ret < 0)
 		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
 
-	panel_aa569_power_off(ctx, "unprepare");
+	/* Rails stay on across unprepare/prepare; only reset, as before. */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 
 	return 0;
 }
@@ -506,6 +507,14 @@ static int panel_aa569_p_3_a0019_dsc_probe(struct mipi_dsi_device *dsi)
 		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
 	}
 
+	/*
+	 * The rails are already on from ABL: take our reference now, so they
+	 * show users=1 and stay on until shutdown or remove. If this fails,
+	 * prepare tries again.
+	 */
+	if (panel_aa569_power_on(ctx) < 0)
+		dev_warn(dev, "supplies not enabled at probe\n");
+
 	return 0;
 }
 
@@ -520,14 +529,15 @@ static void panel_aa569_p_3_a0019_dsc_remove(struct mipi_dsi_device *dsi)
 		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
 
 	drm_panel_remove(&ctx->panel);
+	panel_aa569_power_off(ctx, "remove");
 }
 
 /*
- * Reboot and poweroff: leave the panel unpowered, so ABL starts the next
- * boot from a panel that lost its state, as after a cold start. msm's own
- * shutdown runs later and may call unprepare again; power_off is
- * idempotent. No DCS here: on a wedged link each command would wait for
- * its timeout.
+ * Reboot and poweroff (and remove) are the only places the rails go off:
+ * ABL then starts the next boot from a panel that lost its state, as after
+ * a cold start. msm's own shutdown runs later and may call unprepare again,
+ * which only touches reset; power_off is idempotent. No DCS here: on a
+ * wedged link each command would wait for its timeout.
  */
 static void panel_aa569_p_3_a0019_dsc_shutdown(struct mipi_dsi_device *dsi)
 {
-- 
2.55.0

