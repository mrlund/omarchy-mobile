From 02a123bae988d88b70da77bd1ebc379884fd5c6d Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Thu, 22 Oct 2026 13:22:23 +0200
Subject: [PATCH 51/52] drm/panel: oneplus-dodge: own the panel supplies and
 power them off on unprepare and shutdown

The AA569 driver never requested vddio/vdd/vci, so the rails stayed on
ABL's RPMh vote and the panel was never power-cycled across warm
resets. Enable vddio, vdd, vci one at a time before the reset pulse;
on unprepare, failed init and shutdown assert reset, disable vci, vdd,
vddio and wait 200 ms. Voltages are left to the DT constraints.
---
 .../gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c | 86 ++++++++++++++++++-
 1 file changed, 83 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c b/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
index 2888762f1..4a5258cfc 100644
--- a/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
+++ b/drivers/gpu/drm/panel/panel-aa569-p-3-a0019-dsc.c
@@ -8,6 +8,7 @@
 #include <linux/gpio/consumer.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
+#include <linux/regulator/consumer.h>
 
 #include <drm/display/drm_dsc.h>
 #include <drm/display/drm_dsc_helper.h>
@@ -21,6 +22,18 @@ struct panel_aa569_p_3_a0019_dsc {
 	struct mipi_dsi_device *dsi;
 	struct drm_dsc_config dsc;
 	struct gpio_desc *reset_gpio;
+	/*
+	 * vddio, vdd, vci. Linux never power-cycled these before: ABL's RPMh
+	 * vote kept them on across warm resets, so a wedged panel stayed
+	 * wedged until a cold power-off. Voltages come from the DT
+	 * constraints only; the driver never sets them.
+	 */
+	struct regulator_bulk_data supplies[3];
+	bool powered;
+};
+
+static const char * const panel_aa569_supply_names[] = {
+	"vddio", "vdd", "vci",
 };
 
 static inline
@@ -40,6 +53,48 @@ static void panel_aa569_p_3_a0019_dsc_reset(struct panel_aa569_p_3_a0019_dsc *ct
 	
 }
 
+static int panel_aa569_power_on(struct panel_aa569_p_3_a0019_dsc *ctx)
+{
+	int ret, i;
+
+	if (ctx->powered)
+		return 0;
+	/* One at a time (bulk enable is async): vddio, vdd, vci. */
+	for (i = 0; i < ARRAY_SIZE(ctx->supplies); i++) {
+		ret = regulator_enable(ctx->supplies[i].consumer);
+		if (ret < 0) {
+			dev_err(&ctx->dsi->dev, "failed to enable %s: %d\n",
+				ctx->supplies[i].supply, ret);
+			while (--i >= 0)
+				regulator_disable(ctx->supplies[i].consumer);
+			return ret;
+		}
+		usleep_range(1000, 2000);
+	}
+	ctx->powered = true;
+	usleep_range(10000, 11000);
+	return 0;
+}
+
+/* Reset asserted, then vci, vdd, vddio off, then let the rails discharge. */
+static void panel_aa569_power_off(struct panel_aa569_p_3_a0019_dsc *ctx, const char *why)
+{
+	int i;
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	if (!ctx->powered)
+		return;
+	usleep_range(1000, 2000);
+	for (i = ARRAY_SIZE(ctx->supplies) - 1; i >= 0; i--)
+		regulator_disable(ctx->supplies[i].consumer);
+	ctx->powered = false;
+	msleep(200);
+	dev_info(&ctx->dsi->dev, "dodge: panel power off (%s): vci %d vdd %d vddio %d\n", why,
+		 regulator_is_enabled(ctx->supplies[2].consumer),
+		 regulator_is_enabled(ctx->supplies[1].consumer),
+		 regulator_is_enabled(ctx->supplies[0].consumer));
+}
+
 static int panel_aa569_p_3_a0019_dsc_on(struct panel_aa569_p_3_a0019_dsc *ctx)
 {
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
@@ -255,12 +310,16 @@ static int panel_aa569_p_3_a0019_dsc_prepare(struct drm_panel *panel)
 	struct drm_dsc_picture_parameter_set pps;
 	int ret;
 
+	ret = panel_aa569_power_on(ctx);
+	if (ret < 0)
+		return ret;
+
 	panel_aa569_p_3_a0019_dsc_reset(ctx);
 
 	ret = panel_aa569_p_3_a0019_dsc_on(ctx);
 	if (ret < 0) {
 		dev_err(dev, "Failed to initialize panel: %d\n", ret);
-		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		panel_aa569_power_off(ctx, "init failed");
 		return ret;
 	}
 
@@ -294,7 +353,7 @@ static int panel_aa569_p_3_a0019_dsc_unprepare(struct drm_panel *panel)
 	if (ret < 0)
 		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
 
-	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	panel_aa569_power_off(ctx, "unprepare");
 
 	return 0;
 }
@@ -384,7 +443,7 @@ static int panel_aa569_p_3_a0019_dsc_probe(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
 	struct panel_aa569_p_3_a0019_dsc *ctx;
-	int ret;
+	int ret, i;
 
 	ctx = devm_drm_panel_alloc(dev, struct panel_aa569_p_3_a0019_dsc, panel,
 				   &panel_aa569_p_3_a0019_dsc_panel_funcs,
@@ -392,6 +451,12 @@ static int panel_aa569_p_3_a0019_dsc_probe(struct mipi_dsi_device *dsi)
 	if (IS_ERR(ctx))
 		return PTR_ERR(ctx);
 
+	for (i = 0; i < ARRAY_SIZE(ctx->supplies); i++)
+		ctx->supplies[i].supply = panel_aa569_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get supplies\n");
+
 	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
 	if (IS_ERR(ctx->reset_gpio))
 		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
@@ -457,6 +522,20 @@ static void panel_aa569_p_3_a0019_dsc_remove(struct mipi_dsi_device *dsi)
 	drm_panel_remove(&ctx->panel);
 }
 
+/*
+ * Reboot and poweroff: leave the panel unpowered, so ABL starts the next
+ * boot from a panel that lost its state, as after a cold start. msm's own
+ * shutdown runs later and may call unprepare again; power_off is
+ * idempotent. No DCS here: on a wedged link each command would wait for
+ * its timeout.
+ */
+static void panel_aa569_p_3_a0019_dsc_shutdown(struct mipi_dsi_device *dsi)
+{
+	struct panel_aa569_p_3_a0019_dsc *ctx = mipi_dsi_get_drvdata(dsi);
+
+	panel_aa569_power_off(ctx, "shutdown");
+}
+
 static const struct of_device_id panel_aa569_p_3_a0019_dsc_of_match[] = {
 	{ .compatible = "oneplus,dodge-panel" }, // FIXME
 	{ /* sentinel */ }
@@ -466,6 +545,7 @@ MODULE_DEVICE_TABLE(of, panel_aa569_p_3_a0019_dsc_of_match);
 static struct mipi_dsi_driver panel_aa569_p_3_a0019_dsc_driver = {
 	.probe = panel_aa569_p_3_a0019_dsc_probe,
 	.remove = panel_aa569_p_3_a0019_dsc_remove,
+	.shutdown = panel_aa569_p_3_a0019_dsc_shutdown,
 	.driver = {
 		.name = "panel-panel-aa569-p-3-a0019-dsc",
 		.of_match_table = panel_aa569_p_3_a0019_dsc_of_match,
-- 
2.55.0

