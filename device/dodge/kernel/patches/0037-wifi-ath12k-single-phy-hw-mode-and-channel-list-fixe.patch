From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Tue, 20 Oct 2026 15:14:47 +0200
Subject: [PATCH] wifi: ath12k: single-phy hw mode and channel-list fixes for
 peach

Backport of the generic parts of the upstream QCC2072 series that
peach (one phy, no DBS) needs: pick the preferred hardware mode with
<= so a firmware that reports only the SINGLE mode still fills
pref_hw_mode_caps, parse MAC/PHY caps for the preferred mode only,
and send at most 58 channels per scan channel-list command. Without
them peach registered wlan0 and then stopped answering WMI: the
first command after 'ip link up' timed out waiting for credits.
Logs the chosen hw mode and phy map for PCI id 0x110e.
---
 drivers/net/wireless/ath/ath12k/wmi.c | 16 ++++++++++++----
 drivers/net/wireless/ath/ath12k/wmi.h |  2 ++
 2 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/wmi.c b/drivers/net/wireless/ath/ath12k/wmi.c
index 465f877fc..912050515 100644
--- a/drivers/net/wireless/ath/ath12k/wmi.c
+++ b/drivers/net/wireless/ath/ath12k/wmi.c
@@ -2832,7 +2832,8 @@ int ath12k_wmi_send_scan_chan_list_cmd(struct ath12k *ar,
 		max_chan_limit = (wmi->wmi_ab->max_msg_len[ar->pdev_idx] - len) /
 			sizeof(*chan_info);
 
-		num_send_chans = min(arg->nallchans, max_chan_limit);
+		num_send_chans = min3(arg->nallchans, max_chan_limit,
+				      ATH12K_WMI_MAX_NUM_CHAN_PER_CMD);
 
 		arg->nallchans -= num_send_chans;
 		len += sizeof(*chan_info) * num_send_chans;
@@ -4427,7 +4428,7 @@ static int ath12k_wmi_hw_mode_caps(struct ath12k_base *soc,
 
 		pref = soc->wmi_ab.preferred_hw_mode;
 
-		if (ath12k_hw_mode_pri_map[mode] < ath12k_hw_mode_pri_map[pref]) {
+		if (ath12k_hw_mode_pri_map[mode] <= ath12k_hw_mode_pri_map[pref]) {
 			svc_rdy_ext->pref_hw_mode_caps = *hw_mode_caps;
 			soc->wmi_ab.preferred_hw_mode = mode;
 		}
@@ -4437,6 +4438,14 @@ static int ath12k_wmi_hw_mode_caps(struct ath12k_base *soc,
 
 	ath12k_dbg(soc, ATH12K_DBG_WMI, "num hw modes %u preferred_hw_mode %d\n",
 		   svc_ext_info->num_hw_modes, soc->wmi_ab.preferred_hw_mode);
+	if (soc->id.device == 0x110e)
+		ath12k_info(soc, "wmi %u hw modes, preferred %d, phy map 0x%x\n",
+			    svc_ext_info->num_hw_modes,
+			    soc->wmi_ab.preferred_hw_mode,
+			    le32_to_cpu(svc_rdy_ext->pref_hw_mode_caps.phy_id_map));
+
+	if (soc->wmi_ab.preferred_hw_mode == WMI_HOST_HW_MODE_MAX)
+		return -EINVAL;
 
 	if (soc->wmi_ab.preferred_hw_mode == WMI_HOST_HW_MODE_MAX)
 		return -EINVAL;
@@ -4967,8 +4976,7 @@ static int ath12k_wmi_tlv_mac_phy_caps_ext(struct ath12k_base *ab, u16 tag,
 		return -EPROTO;
 
 	if (ab->hw_params->single_pdev_only) {
-		if (ab->wmi_ab.preferred_hw_mode != le32_to_cpu(caps->hw_mode_id) &&
-		    caps->hw_mode_id != WMI_HOST_HW_MODE_SINGLE)
+		if (ab->wmi_ab.preferred_hw_mode != le32_to_cpu(caps->hw_mode_id))
 			return 0;
 	} else {
 		for (i = 0; i < ab->num_radios; i++) {
diff --git a/drivers/net/wireless/ath/ath12k/wmi.h b/drivers/net/wireless/ath/ath12k/wmi.h
index c640ffa18..fbb419026 100644
--- a/drivers/net/wireless/ath/ath12k/wmi.h
+++ b/drivers/net/wireless/ath/ath12k/wmi.h
@@ -3953,6 +3953,8 @@ struct ath12k_wmi_scan_chan_list_arg {
 	struct ath12k_wmi_channel_arg channel[];
 };
 
+#define ATH12K_WMI_MAX_NUM_CHAN_PER_CMD	58
+
 struct wmi_scan_chan_list_cmd {
 	__le32 tlv_header;
 	__le32 num_scan_chans;
-- 
2.55.0

