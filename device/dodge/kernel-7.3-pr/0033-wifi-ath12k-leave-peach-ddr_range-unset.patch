From 1d6ef7ac98f1145d80afb5ce7e39a1b9b84fbf59 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Mon, 19 Oct 2026 15:01:39 +0200
Subject: [PATCH 33/41] wifi: ath12k: leave peach ddr_range unset

Stock's combined window, start 0 size 0x68000000, reset the
firmware before the memory acknowledgement, as the 36-bit
aperture did. Log the TME-Lite DMA address on the path that
still reaches that request.

(Ported from the dodge v6.16 bring-up tree.)

Signed-off-by: Martin Lund <mrlund@hotmail.com>
---
 drivers/net/wireless/ath/ath12k/qmi.c | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
index 06fc14640..313139325 100644
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2354,9 +2354,10 @@ int ath12k_qmi_host_cap_send(struct ath12k_base *ab)
 	req.cal_done_valid = 1;
 	req.cal_done = ab->qmi.cal_done;
 
-	/* ddr_range can be encoded (ei_array is set above). Sending the
-	 * stage-1 aperture, 0 size 0x1000000000, made peach reset before
-	 * it acknowledged the memory response. Leave it unset.
+	/* ddr_range can be encoded (ei_array is set above). Both
+	 * windows we tried, size 0x1000000000 and stock's 0x68000000,
+	 * made peach reset before it acknowledged the memory response.
+	 * Leave the field unset.
 	 */
 
 	if (ab->hw_params->qmi_cnss_feature_bitmap) {
@@ -3930,6 +3931,9 @@ static int ath12k_qmi_tme_lite_info_send(struct ath12k_base *ab)
 	req.tme_file = WLANFW_TME_LITE_PATCH_FILE_V01;
 	req.addr = paddr;
 	req.size = fw->size;
+	if (ab->id.device == 0x110e)
+		ath12k_info(ab, "qmi tme-lite addr %pad size %zu\n",
+			    &paddr, fw->size);
 
 	ret = qmi_txn_init(&ab->qmi.handle, &txn,
 			   qmi_wlanfw_tme_lite_info_resp_msg_v01_ei, &resp);
