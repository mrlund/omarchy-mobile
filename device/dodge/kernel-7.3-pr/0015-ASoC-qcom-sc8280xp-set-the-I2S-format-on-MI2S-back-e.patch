From d7696fbf2e058ca03c14e8614d1c29a376d4e6a0 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Tue, 20 Oct 2026 11:56:34 +0200
Subject: [PATCH 15/41] ASoC: qcom: sc8280xp: set the I2S format on MI2S back
 ends

MI2S codecs such as speaker amplifiers are clock consumers; set the
runtime format to I2S with the codec as consumer so the q6 I2S DAI
drives BCLK and WS.

Signed-off-by: Martin Lund <mrlund@hotmail.com>
---
 sound/soc/qcom/sc8280xp.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/sound/soc/qcom/sc8280xp.c b/sound/soc/qcom/sc8280xp.c
index 4d48e1012..cf6f640d1 100644
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -193,6 +193,13 @@ static int sc8280xp_snd_init(struct snd_soc_pcm_runtime *rtd)
 		snd_soc_limit_volume(card, "SpkrLeft PA Volume", 17);
 		snd_soc_limit_volume(card, "SpkrRight PA Volume", 17);
 		break;
+	case PRIMARY_MI2S_RX ... QUATERNARY_MI2S_TX:
+	case QUINARY_MI2S_RX ... QUINARY_MI2S_TX:
+		/* The SoC provides BCLK and WS to the MI2S codecs. */
+		snd_soc_runtime_set_dai_fmt(rtd, SND_SOC_DAIFMT_I2S |
+					    SND_SOC_DAIFMT_NB_NF |
+					    SND_SOC_DAIFMT_BC_FC);
+		break;
 	case DISPLAY_PORT_RX_0:
 		/* DISPLAY_PORT dai ids are not contiguous */
 		dp_pcm_id = 0;
