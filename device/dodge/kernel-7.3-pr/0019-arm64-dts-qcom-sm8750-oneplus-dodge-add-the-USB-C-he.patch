From 8df57b7c3d0a6659b158a168c0c6af33d33abef9 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Tue, 20 Oct 2026 12:41:16 +0200
Subject: [PATCH 19/41] arm64: dts: qcom: sm8750-oneplus-dodge: add the USB-C
 headset path

The OnePlus 13 has no 3.5 mm jack: analog headsets use USB-C audio
accessory mode through the WCD939x USBSS switch at 0xe on QUP I2C3
(no reset line, as on stock). Link it into the pmic-glink connector's
SBU port and the codec's headset port, and add the WCD playback link
from RX codec DMA 0 to HPHL/HPHR.

Co-Authored-By: Grok <noreply@x.ai>

Signed-off-by: Martin Lund <mrlund@hotmail.com>
---
 .../boot/dts/qcom/sm8750-oneplus-dodge.dts    | 71 +++++++++++++++++++
 1 file changed, 71 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index c15b55dfe..b103e010a 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -52,11 +52,29 @@ sound {
 				"AMIC3", "MIC BIAS4",
 				"AMIC4", "MIC BIAS3",
 				"AMIC5", "MIC BIAS1",
+				"IN1_HPHL", "HPHL_OUT",
+				"IN2_HPHR", "HPHR_OUT",
 				"TX SWR_INPUT0", "ADC1_OUTPUT",
 				"TX SWR_INPUT1", "ADC2_OUTPUT",
 				"TX SWR_INPUT2", "ADC3_OUTPUT",
 				"TX SWR_INPUT3", "ADC4_OUTPUT";
 
+		wcd-playback-dai-link {
+			link-name = "WCD Playback";
+
+			cpu {
+				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
+			};
+
+			codec {
+				sound-dai = <&wcd939x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
 		wcd-capture-dai-link {
 			link-name = "WCD Capture";
 
@@ -115,6 +133,16 @@ wcd939x: audio-codec {
 		vdd-mic-bias-supply = <&vreg_bob1>;
 
 		#sound-dai-cells = <1>;
+
+		/* No 3.5 mm jack: the headset is analog audio over USB-C. */
+		mode-switch;
+		orientation-switch;
+
+		port {
+			wcd_codec_headset_in: endpoint {
+				remote-endpoint = <&wcd_usbss_headset_out>;
+			};
+		};
 	};
 
 	aliases {
@@ -166,6 +194,13 @@ pmic_glink_ss_in: endpoint {
 						remote-endpoint = <&usb_dp_qmpphy_out>;
 					};
 				};
+
+				port@2 {
+					reg = <2>;
+					pmic_glink_sbu: endpoint {
+						remote-endpoint = <&wcd_usbss_sbu_mux>;
+					};
+				};
 			};
 		};
 	};
@@ -1168,6 +1203,42 @@ &remoteproc_mpss {
 	status = "okay";
 };
 
+&i2c3 {
+	status = "okay";
+
+	/* WCD939x USB-C analog switch; stock has no reset line for it. */
+	wcd_usbss: typec-mux@e {
+		compatible = "qcom,wcd9395-usbss", "qcom,wcd9390-usbss";
+		reg = <0xe>;
+
+		vdd-supply = <&vreg_l15b_1p8>;
+
+		mode-switch;
+		orientation-switch;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				wcd_usbss_sbu_mux: endpoint {
+					remote-endpoint = <&pmic_glink_sbu>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+
+				wcd_usbss_headset_out: endpoint {
+					remote-endpoint = <&wcd_codec_headset_in>;
+				};
+			};
+		};
+	};
+};
+
 &swr1 {
 	status = "okay";
 
