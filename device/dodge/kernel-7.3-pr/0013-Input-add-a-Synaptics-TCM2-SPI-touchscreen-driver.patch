From e2d0bf36e02dfb448114aa4fecb0eb142785b13a Mon Sep 17 00:00:00 2001
From: index986 <index986.github@gmail.com>
Date: Sun, 25 Oct 2026 09:06:21 +0100
Subject: [PATCH 13/45] Input: add a Synaptics TCM2 SPI touchscreen driver

Add the Synaptics TouchComm v2 (TCM2) SPI touchscreen driver used on the
OnePlus 13, carried over from the sm8750-mainline v6.16 tree and ported
to the 7.3 SPI and input APIs.

Link: https://github.com/sm8750-mainline/linux/tree/v6.16/drivers/input/touchscreen/syna_tcm2.c
[mrlund: Synaptics vendor driver as carried in the sm8750-mainline v6.16
 tree (index986, no Signed-off-by there); ported to 7.3, checkpatch
 error fixes]
Signed-off-by: Martin Lund <mrlund@hotmail.com>
---
 drivers/input/touchscreen/Kconfig         |   12 +
 drivers/input/touchscreen/Makefile        |    3 +
 drivers/input/touchscreen/syna_tcm2.c     | 2386 +++++++++++++++++++++
 drivers/input/touchscreen/syna_tcm2.h     | 1228 +++++++++++
 drivers/input/touchscreen/syna_tcm2_spi.c |  710 ++++++
 5 files changed, 4339 insertions(+)
 create mode 100644 drivers/input/touchscreen/syna_tcm2.c
 create mode 100644 drivers/input/touchscreen/syna_tcm2.h
 create mode 100644 drivers/input/touchscreen/syna_tcm2_spi.c

diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 10f4ddb2c..e6eb1f498 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1429,4 +1429,16 @@ config TOUCHSCREEN_HIMAX_HX83112B
 	  To compile this driver as a module, choose M here: the
 	  module will be called himax_hx83112b.
 
+config TOUCHSCREEN_SYNA_TCM2
+	tristate "Synaptics TCM touchscreen over SPI"
+	depends on SPI
+	help
+	  Say Y here if you have a Synaptics TCM touchscreen on SPI,
+	  such as the S3910 (compatible "synaptics,tcm-spi-hbp").
+
+	  If unsure, say N.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called synaptics_tcm2.
+
 endif
diff --git a/drivers/input/touchscreen/Makefile b/drivers/input/touchscreen/Makefile
index db500698e..94c3167a4 100644
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -120,3 +120,6 @@ obj-$(CONFIG_TOUCHSCREEN_IQS5XX)	+= iqs5xx.o
 obj-$(CONFIG_TOUCHSCREEN_IQS7211)	+= iqs7211.o
 obj-$(CONFIG_TOUCHSCREEN_ZINITIX)	+= zinitix.o
 obj-$(CONFIG_TOUCHSCREEN_HIMAX_HX83112B)	+= himax_hx83112b.o
+# syna_tcm2.c cannot be both the member and the module name.
+obj-$(CONFIG_TOUCHSCREEN_SYNA_TCM2) += synaptics_tcm2.o
+synaptics_tcm2-y := syna_tcm2.o syna_tcm2_spi.o
