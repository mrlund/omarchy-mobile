From 56e4dec8280331bbe193463f6752725a65429260 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Sun, 25 Oct 2026 16:01:46 +0100
Subject: [PATCH 31/35] wifi: ath12k: add WCN7860 (peach) on the QCC2072 HAL

WCN7860 (PCI 17cb:110e, "peach", the Wi-Fi/BT combo on SM8750 phones)
reports SOC hw version 2 like WCN7850. Its UMAC register map, window
register (0x3278), RX descriptor and 32-bit REO TLV rings are QCC2072's
instead.

Add ATH12K_HW_WCN7860_HW20 with the QCC2072 HAL map and hw_params
based on QCC2072 (firmware in WCN7860/hw2.0), and claim the device in
the wifi7 PCI driver. ATH12K_PCI_DEVICE_ID_WCN7860 goes in core.h,
because QMI also needs it.

Two differences from QCC2072:
- The host feature list is PERST_NO_PULL | AUX_UC_SUPPORT (0x50),
  without QDSS_CFG_MISS. With that bit set, the firmware starts
  initializing before the host has sent the aux ucode and QDSS config,
  refuses both with QMI error 90 and asserts in the aux MAC wakeup.
  The vendor driver sets the bit only when the QDSS file is missing.
- The DMA masks are limited to 28 bits. Without that, coherent
  allocations for this chip land at the top of the 32-bit space, while
  the vendor driver's DMA window for it is the low 384 MiB. The 28-bit
  mask keeps the firmware segments inside that window.

Assisted-by: Grok
Signed-off-by: Martin Lund <mrlund@hotmail.com>
---
 drivers/net/wireless/ath/ath12k/core.h      |  4 +
 drivers/net/wireless/ath/ath12k/pci.c       | 15 +++-
 drivers/net/wireless/ath/ath12k/wifi7/hal.c |  8 ++
 drivers/net/wireless/ath/ath12k/wifi7/hw.c  | 98 +++++++++++++++++++++
 drivers/net/wireless/ath/ath12k/wifi7/pci.c | 15 ++++
 5 files changed, 138 insertions(+), 2 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
index a98fc6e06..47f420549 100644
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -159,8 +159,12 @@ enum ath12k_hw_rev {
 	ATH12K_HW_IPQ5332_HW10,
 	ATH12K_HW_QCC2072_HW10,
 	ATH12K_HW_IPQ5424_HW10,
+	ATH12K_HW_WCN7860_HW20,
 };
 
+/* WCN7860 (peach); its QMI and DMA setup differ from the other chips */
+#define ATH12K_PCI_DEVICE_ID_WCN7860	0x110e
+
 #define ATH12K_IRQ_NUM_MAX 57
 #define ATH12K_EXT_IRQ_NUM_MAX	16
 #define ATH12K_MAX_TCL_RING_NUM	3
diff --git a/drivers/net/wireless/ath/ath12k/pci.c b/drivers/net/wireless/ath/ath12k/pci.c
index 6441927b5..715239112 100644
--- a/drivers/net/wireless/ath/ath12k/pci.c
+++ b/drivers/net/wireless/ath/ath12k/pci.c
@@ -21,6 +21,7 @@
 
 #define ATH12K_PCI_BAR_NUM		0
 #define ATH12K_PCI_DMA_MASK		36
+#define ATH12K_PCI_DMA_MASK_WCN7860	28
 
 #define ATH12K_PCI_IRQ_CE0_OFFSET		3
 
@@ -860,9 +861,19 @@ static int ath12k_pci_claim(struct ath12k_pci *ab_pci, struct pci_dev *pdev)
 		goto disable_device;
 	}
 
-	ab_pci->dma_mask = DMA_BIT_MASK(ATH12K_PCI_DMA_MASK);
+	/* WCN7860 firmware fails when its memory is allocated near the
+	 * top of the 32-bit DMA space (0xfe400000 and up); the vendor
+	 * driver keeps it low. Limit both masks to 256 MiB for it.
+	 */
+	if (device_id == ATH12K_PCI_DEVICE_ID_WCN7860)
+		ab_pci->dma_mask = DMA_BIT_MASK(ATH12K_PCI_DMA_MASK_WCN7860);
+	else
+		ab_pci->dma_mask = DMA_BIT_MASK(ATH12K_PCI_DMA_MASK);
 	dma_set_mask(&pdev->dev, ab_pci->dma_mask);
-	dma_set_coherent_mask(&pdev->dev, DMA_BIT_MASK(32));
+	if (device_id == ATH12K_PCI_DEVICE_ID_WCN7860)
+		dma_set_coherent_mask(&pdev->dev, ab_pci->dma_mask);
+	else
+		dma_set_coherent_mask(&pdev->dev, DMA_BIT_MASK(32));
 
 	pci_set_master(pdev);
 
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/hal.c b/drivers/net/wireless/ath/ath12k/wifi7/hal.c
index a0a1902fb..7175383ce 100644
--- a/drivers/net/wireless/ath/ath12k/wifi7/hal.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hal.c
@@ -57,6 +57,14 @@ static const struct ath12k_hw_version_map ath12k_wifi7_hw_ver_map[] = {
 		.hal_params = &ath12k_hw_hal_params_ipq5332,
 		.hw_regs = &ipq5424_regs,
 	},
+	/* WCN7860 (peach) has the QCC2072 UMAC: same regs and descriptors */
+	[ATH12K_HW_WCN7860_HW20] = {
+		.hal_ops = &hal_qcc2072_ops,
+		.hal_desc_sz = sizeof(struct hal_rx_desc_qcc2072),
+		.tcl_to_wbm_rbm_map = ath12k_hal_tcl_to_wbm_rbm_map_wcn7850,
+		.hal_params = &ath12k_hw_hal_params_wcn7850,
+		.hw_regs = &qcc2072_regs,
+	},
 };
 
 int ath12k_wifi7_hal_init(struct ath12k_base *ab)
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/hw.c b/drivers/net/wireless/ath/ath12k/wifi7/hw.c
index 7b86f324b..095a0bc1e 100644
--- a/drivers/net/wireless/ath/ath12k/wifi7/hw.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hw.c
@@ -806,6 +806,104 @@ static const struct ath12k_hw_params ath12k_wifi7_hw_params[] = {
 			.max_client_dbs_sbs = 128,
 		},
 
+		.host_alloc_ml_id = false,
+	},	{
+		.name = "wcn7860 hw2.0",
+		.hw_rev = ATH12K_HW_WCN7860_HW20,
+
+		.fw = {
+			.dir = "WCN7860/hw2.0",
+			.board_size = 256 * 1024,
+			.cal_offset = 256 * 1024,
+			.m3_loader = ath12k_m3_fw_loader_driver,
+			.download_aux_ucode = true,
+		},
+
+		.max_radios = 1,
+		.single_pdev_only = true,
+		.qmi_service_ins_id = ATH12K_QMI_WLFW_SERVICE_INS_ID_V01_WCN7850,
+		.internal_sleep_clock = true,
+
+		.hw_ops = &qcc2072_ops,
+		.ring_mask = &ath12k_wifi7_hw_ring_mask_wcn7850,
+
+		.host_ce_config = ath12k_wifi7_host_ce_config_wcn7850,
+		.ce_count = 9,
+		.target_ce_config = ath12k_wifi7_target_ce_config_wlan_wcn7850,
+		.target_ce_count = 9,
+		.svc_to_ce_map =
+			ath12k_wifi7_target_service_to_ce_map_wlan_wcn7850,
+		.svc_to_ce_map_len = 14,
+
+		.rxdma1_enable = false,
+		.num_rxdma_per_pdev = 2,
+		.num_rxdma_dst_ring = 1,
+		.rx_mac_buf_ring = true,
+		.vdev_start_delay = true,
+
+		.interface_modes = BIT(NL80211_IFTYPE_STATION) |
+				   BIT(NL80211_IFTYPE_AP) |
+				   BIT(NL80211_IFTYPE_P2P_DEVICE) |
+				   BIT(NL80211_IFTYPE_P2P_CLIENT) |
+				   BIT(NL80211_IFTYPE_P2P_GO),
+		.supports_monitor = true,
+		.supports_cong_ctrl_max_msdus = false,
+
+		.idle_ps = true,
+		.download_calib = false,
+		.supports_suspend = true,
+		.tcl_ring_retry = false,
+		.reoq_lut_support = false,
+		.supports_shadow_regs = true,
+
+		.num_tcl_banks = 7,
+		.max_tx_ring = 3,
+
+		.mhi_config = &ath12k_wifi7_mhi_config_wcn7850,
+
+		.wmi_init = ath12k_wifi7_wmi_init_wcn7850,
+
+		/* Not QDSS_CFG_MISS: with it peach starts initializing at
+		 * once, rejects aux and qdss with err 90 (incompatible
+		 * state) and asserts in the aux MAC wakeup. Stock cnss2 sets
+		 * it only when the qdss file is missing. 0x50.
+		 */
+		.qmi_cnss_feature_bitmap = BIT(CNSS_PCIE_PERST_NO_PULL_V01) |
+					   BIT(CNSS_AUX_UC_SUPPORT_V01),
+
+		.rfkill_pin = 0,
+		.rfkill_cfg = 0,
+		.rfkill_on_level = 0,
+
+		.rddm_size = 0x780000,
+
+		.def_num_link = 2,
+		.max_mlo_peer = 32,
+
+		.otp_board_id_register = 0,
+
+		.supports_sta_ps = true,
+
+		.acpi_guid = &wcn7850_uuid,
+		.supports_dynamic_smps_6ghz = false,
+
+		.iova_mask = 0,
+
+		.supports_aspm = true,
+
+		.ce_ie_addr = NULL,
+		.ce_remap = NULL,
+		.bdf_addr_offset = 0,
+
+		.current_cc_support = true,
+
+		.dp_primary_link_only = false,
+		.client = {
+			.max_client_single = 512,
+			.max_client_dbs = 128,
+			.max_client_dbs_sbs = 128,
+		},
+
 		.host_alloc_ml_id = false,
 	},
 	{
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/pci.c b/drivers/net/wireless/ath/ath12k/wifi7/pci.c
index 6c96b52de..0c0625c48 100644
--- a/drivers/net/wireless/ath/ath12k/wifi7/pci.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/pci.c
@@ -20,6 +20,7 @@
 #define QCN9274_DEVICE_ID		0x1109
 #define WCN7850_DEVICE_ID		0x1107
 #define QCC2072_DEVICE_ID		0x1112
+#define WCN7860_DEVICE_ID		ATH12K_PCI_DEVICE_ID_WCN7860
 
 #define ATH12K_PCI_W7_SOC_HW_VERSION_1	1
 #define ATH12K_PCI_W7_SOC_HW_VERSION_2	2
@@ -35,6 +36,7 @@ static const struct pci_device_id ath12k_wifi7_pci_id_table[] = {
 	{ PCI_VDEVICE(QCOM, QCN9274_DEVICE_ID) },
 	{ PCI_VDEVICE(QCOM, WCN7850_DEVICE_ID) },
 	{ PCI_VDEVICE(QCOM, QCC2072_DEVICE_ID) },
+	{ PCI_VDEVICE(QCOM, WCN7860_DEVICE_ID) },
 	{}
 };
 
@@ -165,6 +167,19 @@ static int ath12k_wifi7_pci_probe(struct pci_dev *pdev,
 		/* there is only one version till now */
 		ab->hw_rev = ATH12K_HW_QCC2072_HW10;
 		break;
+	case WCN7860_DEVICE_ID:
+		/*
+		 * WCN7860 (peach) reports SOC hw version 2 like WCN7850, but
+		 * its UMAC, window register and RX descriptors are QCC2072's.
+		 */
+		ab->id.bdf_search = ATH12K_BDF_SEARCH_BUS_AND_BOARD;
+		ab_pci->msi_config = &ath12k_wifi7_msi_config[0];
+		ab->static_window_map = false;
+		ab_pci->pci_ops = &ath12k_wifi7_pci_ops_wcn7850;
+		ab_pci->window_reg_addr = WINDOW_REG_ADDRESS_QCC2072;
+		ab->target_mem_mode = ATH12K_QMI_MEMORY_MODE_DEFAULT;
+		ab->hw_rev = ATH12K_HW_WCN7860_HW20;
+		break;
 	default:
 		dev_err(&pdev->dev, "Unknown Wi-Fi 7 PCI device found: 0x%x\n",
 			pci_dev->device);
-- 
2.56.0

