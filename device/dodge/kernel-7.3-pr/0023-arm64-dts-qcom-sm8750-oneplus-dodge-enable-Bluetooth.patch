From 392c58e1aa912d647dd83ec71b48dd6adc42eceb Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Tue, 20 Oct 2026 16:23:04 +0200
Subject: [PATCH 23/35] arm64: dts: qcom: sm8750-oneplus-dodge: enable
 Bluetooth

The Bluetooth half of the WCN7860 sits on QUP UART14, as on stock
(qcom,msm-geni-serial-hs at 0x898000 with the BT wake byte). Use the
qcom,wcn7860-bt compatible and enable it. Power comes from the PMU
node's bluetooth target.

Signed-off-by: Martin Lund <mrlund@hotmail.com>
---
 arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
index f7edd9ed8..6ca28cd49 100644
--- a/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dts
@@ -1405,7 +1405,7 @@ &uart14 {
 	status = "okay";
 
 	bluetooth {
-		compatible = "qcom,wcn7880-bt";
+		compatible = "qcom,wcn7860-bt";
 
 		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
 		vddaon-supply = <&vreg_pmu_aon_0p59>;
@@ -1416,7 +1416,6 @@ bluetooth {
 		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
 
 		max-speed = <3200000>;
-		status = "disabled";
 	};
 };
 
