From e664016463c276c4e9f7592bb48c2c8d958e7755 Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Sun, 25 Oct 2026 09:17:23 +0100
Subject: [PATCH 05/35] ASoC: dt-bindings: add the Awinic AW882308 amplifier

Document the Awinic AW882308 (chip id 0x2308) smart amplifier used for
the speakers and the earpiece of the OnePlus 13. It is controlled over
I2C, takes I2S/TDM audio and has an optional reset line. Unlike the
AW88395 family it needs no channel or firmware-name property, so it
gets its own schema.

Assisted-by: Grok
Signed-off-by: Martin Lund <mrlund@hotmail.com>
---
 .../bindings/sound/awinic,aw882308.yaml       | 57 +++++++++++++++++++
 1 file changed, 57 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/sound/awinic,aw882308.yaml

diff --git a/Documentation/devicetree/bindings/sound/awinic,aw882308.yaml b/Documentation/devicetree/bindings/sound/awinic,aw882308.yaml
new file mode 100644
index 000000000..89ccad8c9
--- /dev/null
+++ b/Documentation/devicetree/bindings/sound/awinic,aw882308.yaml
@@ -0,0 +1,57 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/awinic,aw882308.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Awinic AW882308 Smart Audio Amplifier
+
+maintainers:
+  - Martin Lund <mrlund@hotmail.com>
+
+description:
+  The Awinic AW882308 (chip id 0x2308) is an I2C controlled, I2S/TDM
+  input mono smart audio amplifier with an integrated boost converter,
+  used for the speakers and earpiece of the OnePlus 13.
+
+properties:
+  compatible:
+    const: awinic,aw882308
+
+  reg:
+    maxItems: 1
+
+  '#sound-dai-cells':
+    const: 0
+
+  reset-gpios:
+    maxItems: 1
+
+  sound-name-prefix: true
+
+required:
+  - compatible
+  - reg
+  - '#sound-dai-cells'
+
+allOf:
+  - $ref: dai-common.yaml#
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        audio-codec@34 {
+            compatible = "awinic,aw882308";
+            reg = <0x34>;
+            reset-gpios = <&tlmm 2 GPIO_ACTIVE_LOW>;
+            #sound-dai-cells = <0>;
+            sound-name-prefix = "Left";
+        };
+    };
-- 
