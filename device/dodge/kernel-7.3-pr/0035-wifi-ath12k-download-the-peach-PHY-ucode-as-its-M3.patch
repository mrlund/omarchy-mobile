From 4afc174dfad39443f6f582c510b4898d3acc4b9f Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Mon, 19 Oct 2026 16:57:11 +0200
Subject: [PATCH 35/41] wifi: ath12k: download the peach PHY ucode as its M3

Stock sends phy_ucode20.elf as the M3 image. The PHY download is
accepted.

7.3 port: upstream 7.3 has native aux ucode download for QCC2072
(fw.download_aux_ucode, ath12k_qmi_aux_uc_load, AUX_UC_INFO 0x005A),
which the WCN7860 entry inherits. The 6.16 aux half of this patch
(its own aux_uc structs, ei arrays and send function) is dropped.
Upstream loads <fw dir>/aux_ucode.bin, so the firmware package must
provide WCN7860/hw2.0/aux_ucode.bin (the stock aux_ucode20.elf).

(Ported from the dodge v6.16 bring-up tree, PHY half only.)

Signed-off-by: Martin Lund <mrlund@hotmail.com>
---
 drivers/net/wireless/ath/ath12k/qmi.c | 58 ++++++++++++++++++++++-----
 1 file changed, 47 insertions(+), 11 deletions(-)

diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
index 72f41f4ad..1d97614b3 100644
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -2348,11 +2348,9 @@ int ath12k_qmi_host_cap_send(struct ath12k_base *ab)
 	req.bdf_support_valid = 1;
 	req.bdf_support = 1;
 
-	/* Peach carries its PHY M3 inside amss. Advertising a host M3
-	 * and then not providing one faults the secured init.
+	/* Peach downloads phy_ucode20.elf as its M3. Advertise it.
 	 */
-	if (ab->hw_params->fw.m3_loader == ath12k_m3_fw_loader_driver &&
-	    ab->id.device != 0x110e) {
+	if (ab->hw_params->fw.m3_loader == ath12k_m3_fw_loader_driver) {
 		req.m3_support_valid = 1;
 		req.m3_support = 1;
 		req.m3_cache_support_valid = 1;
@@ -3300,6 +3298,45 @@ static void ath12k_qmi_m3_free(struct ath12k_base *ab)
 	m3_mem->size = 0;
 }
 
+static int ath12k_qmi_load_mem_file(struct ath12k_base *ab,
+				    struct m3_mem_region *mem,
+				    const char *filename)
+{
+	const struct firmware *fw;
+	int ret;
+
+	fw = ath12k_core_firmware_request(ab, filename);
+	if (IS_ERR(fw)) {
+		ret = PTR_ERR(fw);
+		ath12k_err(ab, "failed to load %s: %d\n", filename, ret);
+		return ret;
+	}
+
+	if (mem->vaddr && mem->size < fw->size) {
+		dma_free_coherent(ab->dev, mem->size, mem->vaddr, mem->paddr);
+		mem->vaddr = NULL;
+		mem->size = 0;
+	}
+
+	if (!mem->vaddr) {
+		mem->vaddr = dma_alloc_coherent(ab->dev, fw->size, &mem->paddr,
+						GFP_KERNEL);
+		if (!mem->vaddr) {
+			ath12k_err(ab, "failed to allocate %zu bytes for %s\n",
+				   fw->size, filename);
+			release_firmware(fw);
+			return -ENOMEM;
+		}
+	}
+
+	memcpy(mem->vaddr, fw->data, fw->size);
+	mem->size = fw->size;
+	ath12k_info(ab, "qmi loaded %s size %zu addr %pad\n",
+		    filename, fw->size, &mem->paddr);
+	release_firmware(fw);
+	return 0;
+}
+
 static int ath12k_qmi_m3_load(struct ath12k_base *ab)
 {
 	struct m3_mem_region *m3_mem = &ab->qmi.m3_mem;
@@ -3373,13 +3410,12 @@ int ath12k_qmi_wlanfw_m3_info_send(struct ath12k_base *ab)
 	struct qmi_txn txn;
 	int ret = 0;
 
-	/* Same as host_cap: peach's M3 is already in amss. A separate
-	 * m3.bin is the WCN7850 image and the firmware faults on it.
-	 * Leave addr and size zero.
-	 */
-	if (ab->hw_params->fw.m3_loader == ath12k_m3_fw_loader_driver &&
-	    ab->id.device != 0x110e) {
-		ret = ath12k_qmi_m3_load(ab);
+	if (ab->hw_params->fw.m3_loader == ath12k_m3_fw_loader_driver) {
+		if (ab->id.device == 0x110e)
+			ret = ath12k_qmi_load_mem_file(ab, &ab->qmi.m3_mem,
+						       "phy_ucode20.elf");
+		else
+			ret = ath12k_qmi_m3_load(ab);
 		if (ret) {
 			ath12k_err(ab, "failed to load m3 firmware: %d\n", ret);
 			return ret;
