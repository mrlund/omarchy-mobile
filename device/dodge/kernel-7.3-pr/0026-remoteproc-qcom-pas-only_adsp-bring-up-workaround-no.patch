From 465e0236ac853bd0273a94171f213475f0a9727b Mon Sep 17 00:00:00 2001
From: Martin Lund <mrlund@hotmail.com>
Date: Wed, 21 Oct 2026 14:51:58 +0200
Subject: [PATCH 26/45] remoteproc: qcom: pas: only_adsp bring-up workaround
 (not for upstream)

Bring-up workaround, not for upstream: add an only_adsp module parameter.
With only_adsp=1 the PAS driver binds the ADSP instance only and leaves
every other PAS instance alone.

Why it is needed: the OnePlus 13 device tree marks the modem and CDSP
PAS nodes okay. Probing the modem assigns its RAM to the modem VM, and
the CDSP boots itself. With only_adsp=1 audio (ADSP) keeps working while
the modem stays off by default.

What a proper fix looks like: keep the modem and CDSP nodes disabled in
the board device tree until their firmware, memory carveouts and power
handling work on this phone, and enable them per node once they do. A
module parameter that decides which DT nodes the driver binds is not
acceptable upstream, so this patch must be dropped before submission.

Signed-off-by: Martin Lund <mrlund@hotmail.com>
---
 drivers/remoteproc/qcom_q6v5_pas.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/remoteproc/qcom_q6v5_pas.c b/drivers/remoteproc/qcom_q6v5_pas.c
index a005546c2..454baa3ca 100644
--- a/drivers/remoteproc/qcom_q6v5_pas.c
+++ b/drivers/remoteproc/qcom_q6v5_pas.c
@@ -818,6 +818,15 @@ static void qcom_pas_unassign_memory_region(struct qcom_pas *pas)
 	}
 }
 
+/*
+ * The dodge DTB marks the modem and CDSP PAS nodes okay. Probing the
+ * modem assigns its RAM to the modem VM, and the CDSP boots itself.
+ * insmod only_adsp=1 binds the ADSP and leaves those two alone.
+ */
+static bool only_adsp;
+module_param(only_adsp, bool, 0444);
+MODULE_PARM_DESC(only_adsp, "Probe the ADSP only");
+
 static int qcom_pas_probe(struct platform_device *pdev)
 {
 	const struct qcom_pas_data *desc;
@@ -828,6 +837,11 @@ static int qcom_pas_probe(struct platform_device *pdev)
 	const struct rproc_ops *ops = &qcom_pas_ops;
 	int ret;
 
+	if (only_adsp &&
+	    !of_device_is_compatible(pdev->dev.of_node, "qcom,sm8750-adsp-pas") &&
+	    !of_device_is_compatible(pdev->dev.of_node, "qcom,sm8550-adsp-pas"))
+		return -ENODEV;
+
 	desc = of_device_get_match_data(&pdev->dev);
 	if (!desc)
 		return -EINVAL;
