# Starts the MPSS once rmtfs and tqftpserv run. Needs only_adsp=0, which
# adsp-battery.sh uses when the same flag file exists.
[Unit]
Description=dodge modem DSP start
ConditionPathExists=/etc/omamobile/modem-probe.enable
Requires=omamobile-rmtfs.service omamobile-tqftpserv.service
After=omamobile-rmtfs.service omamobile-tqftpserv.service omamobile-adsp-battery.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/omamobile/modem/omamobile-modem start
ExecStop=/usr/local/lib/omamobile/modem/omamobile-modem stop

[Install]
WantedBy=multi-user.target
