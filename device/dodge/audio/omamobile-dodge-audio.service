# SPDX-License-Identifier: MIT
# dodge speaker audio at boot: FastRPC audio PD, q6apm, the amplifiers and
# the bring-up card, then the MultiMedia1 -> speakers route. Installed by
# hand to /etc/systemd/system with the files in /root/audio (see
# device/dodge/NOTES.md). The amplifier driver keeps its volume floor.
[Unit]
Description=dodge speaker audio bring-up
Requires=omamobile-adsp-battery.service
After=omamobile-adsp-battery.service systemd-udev-settle.service systemd-modules-load.service
ConditionPathExists=/root/audio/audio-bringup.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/root/audio/audio-bringup.sh pins=1 amps=1
ExecStartPost=/usr/bin/amixer -q -c OnePlusdodge cset name="SECONDARY_MI2S_RX Audio Mixer MultiMedia1" 1
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
