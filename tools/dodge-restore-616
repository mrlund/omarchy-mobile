#!/usr/bin/env bash
# dodge-restore-616: put the 6.16 boot chain back on boot_a (the fallback
# kept when 7.3 became the flashed default, 2026-10-24).
#   tools/dodge-restore-616          flash boot_a, set_active a, reboot
#   tools/dodge-restore-616 once     one-shot: fastboot boot (nothing written)
#   tools/dodge-restore-616 print    print the commands only
# The phone must be in fastboot. Only boot_a is written; slot a is set active.
# Equivalent one-liners:
#   fastboot flash boot_a "$FALLBACK" && fastboot set_active a && fastboot reboot
#   fastboot boot "$FALLBACK"
set -euo pipefail
FALLBACK="${FALLBACK:-$HOME/android/mainline/images/FALLBACK-6.16-boot_a-9940497e.img}"
SHA=9940497e7870b8b6b5ef1d28166801dbdbcf4f22a8e24f32e468f11a6b044af4
mode="${1:-flash}"
if [[ $mode == print ]]; then
  echo "fastboot flash boot_a $FALLBACK && fastboot set_active a && fastboot reboot"
  echo "fastboot boot $FALLBACK"; exit 0
fi
[[ -f $FALLBACK ]] || { echo "missing $FALLBACK" >&2; exit 1; }
echo "$SHA  $FALLBACK" | sha256sum -c --quiet || { echo "fallback sha256 mismatch" >&2; exit 1; }
[[ $(stat -c %s "$FALLBACK") == 100663296 ]] || { echo "fallback is not 96 MiB" >&2; exit 1; }
fastboot devices | grep -q fastboot || { echo "phone is not in fastboot" >&2; exit 1; }
case "$mode" in
  once)  fastboot boot "$FALLBACK" ;;
  flash) fastboot flash boot_a "$FALLBACK" && fastboot set_active a && fastboot reboot ;;
  *) echo "usage: $0 [flash|once|print]" >&2; exit 2 ;;
esac
