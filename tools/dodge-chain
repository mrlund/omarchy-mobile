#!/bin/bash
# SPDX-License-Identifier: MIT
# dodge-chain: build the OnePlus 13 kexec chain-loader image, and (boot
# subcommand only) hand it to fastboot and time what comes back.
#
#   tools/dodge-chain pack   stage 2 DTB, stage 1 kernel, boot-chain.img
#   tools/dodge-chain boot   pack, fastboot boot, then a timeline
#
# ABL does not start header v2 images under fastboot boot, and ignores a
# ramdisk in an uploaded v4 boot.img (device/dodge/PLAN.md §5.3). So
# stage 1 is our kernel with a built-in initramfs and a forced cmdline,
# packed as a kernel-only header v4 image. ABL starts it on stock's DTB;
# its init (device/dodge/chainload/init) kexecs stage 2: our kernel,
# our DTB, our initramfs. Nothing is flashed.
#
# Stage 2 comes from tools/dodge-try pack (Image, DTB, initramfs in
# $STAGE2_OUT). Run that first.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
KERNEL_DIR="${KERNEL_DIR:-$HOME/android/mainline/wt-dodge}"
STAGE2_OUT="${STAGE2_OUT:-$HOME/android/mainline/out-dodge}"
CHAIN_OUT="${CHAIN_OUT:-$HOME/android/mainline/out-dodge-chain}"
JOBS="${JOBS:-$(nproc)}"
# The phone's live FDT, from the rooted capture. Never committed.
LIVE_DTB="${LIVE_DTB:-$HOME/android/reference/dodge-cph2653/rooted-2026-10-15-on/live.dtb}"
# Space-separated stage2-dtb.py options: ramoops, fb.
DTB_OPTS="${DTB_OPTS:-}"
STAGE2_IMAGE="${STAGE2_IMAGE:-$STAGE2_OUT/arch/arm64/boot/Image}"
STAGE2_DTB_IN="${STAGE2_DTB_IN:-$STAGE2_OUT/arch/arm64/boot/dts/qcom/sm8750-oneplus-dodge.dtb}"
STAGE2_INITRD="${STAGE2_INITRD:-$STAGE2_OUT/initramfs.cpio.lz4}"
STAGE2_CMDLINE="${STAGE2_CMDLINE:-rdinit=/init clk_ignore_unused pd_ignore_unused panic=10 console=tty0}"
STAGE1_CMDLINE="rdinit=/omamobile/init panic=10"
ALPINE_VER=3.24.2
ALPINE_SUM=9bf70a7f18ea44094cbb5f70c58f9af129c8214745743db0e68e5502cc2ce773
DEADLINE="${DEADLINE:-280}"

say() { printf '\e[1m==> %s\e[0m\n' "$*"; }
die() { printf '\e[31merror:\e[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<USAGE
Usage: tools/dodge-chain <pack|boot>

  pack   Stage 2 DTB (live memory map, DTB_OPTS), stage 1 kernel with the
         built-in chain-loader, and \$CHAIN_OUT/images/boot-chain.img. No phone.
  boot   pack, then fastboot boot and print a timeline until adb, SSH or
         ${DEADLINE}s. Talks to the phone. Never flashes.

STAGE2_OUT=$STAGE2_OUT   CHAIN_OUT=$CHAIN_OUT
STAGE2_INITRD=$STAGE2_INITRD
STAGE2_CMDLINE=$STAGE2_CMDLINE
DTB_OPTS='$DTB_OPTS'
USAGE
}

cmd_pack() {
  local f
  for f in "$STAGE2_IMAGE" "$STAGE2_DTB_IN" "$STAGE2_INITRD" "$STAGE2_OUT/.config"; do
    [[ -f $f ]] || die "missing $f (run tools/dodge-try pack first)"
  done
  [[ -f $LIVE_DTB ]] || die "missing $LIVE_DTB (the rooted live FDT)"
  command -v mkbootimg >/dev/null || die "mkbootimg is not installed (android-tools)"
  local work="$CHAIN_OUT/chain" dl="$HOME/android/downloads/alpine" apk
  mkdir -p "$work/x" "$CHAIN_OUT/images"

  say "Stage 2 DTB (options: ${DTB_OPTS:-none})"
  # shellcheck disable=SC2086
  python3 -I "$ROOT/device/dodge/chainload/stage2-dtb.py" \
    "$STAGE2_DTB_IN" "$LIVE_DTB" "$work/dodge.dtb" $DTB_OPTS

  say "Alpine busybox-static, kexec-tools and musl"
  local tarball="alpine-minirootfs-$ALPINE_VER-aarch64.tar.gz"
  if [[ ! -f $dl/$tarball ]]; then
    mkdir -p "$dl"
    curl -fsSL -o "$dl/$tarball" \
      "https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_VER%.*}/releases/aarch64/$tarball"
  fi
  echo "$ALPINE_SUM  $dl/$tarball" | sha256sum -c --quiet \
    || die "checksum mismatch for $tarball"
  rm -rf "$work/x" && mkdir -p "$work/x"
  tar -xzf "$dl/$tarball" -C "$work/x"
  for apk in $(python3 -I "$ROOT/tools/alpine-fetch.py" "$ALPINE_VER" "$dl/apks" \
      busybox-static kexec-tools); do
    tar -xzf "$apk" -C "$work/x" --exclude='.PKGINFO' --exclude='.SIGN.*' --exclude='.*.sh' \
      2>/dev/null || true
  done
  local x="$work/x" lzma zstd
  lzma=$(ls "$x"/usr/lib/liblzma.so.5.* | head -1)
  zstd=$(ls "$x"/usr/lib/libzstd.so.1.* | head -1)
  [[ -x $x/bin/busybox.static && -x $x/usr/sbin/kexec && -f $lzma && -f $zstd ]] \
    || die "Alpine packages incomplete under $x"
  printf '%s\n' "$STAGE2_CMDLINE" > "$work/cmdline"

  cat > "$work/list" <<EOF
dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
dir /proc 0755 0 0
dir /omamobile 0755 0 0
dir /omamobile/lib 0755 0 0
file /omamobile/busybox $x/bin/busybox.static 0755 0 0
file /omamobile/init $ROOT/device/dodge/chainload/init 0755 0 0
file /omamobile/kexec $x/usr/sbin/kexec 0755 0 0
file /omamobile/lib/ld-musl-aarch64.so.1 $x/lib/ld-musl-aarch64.so.1 0755 0 0
file /omamobile/lib/libc.musl-aarch64.so.1 $x/lib/ld-musl-aarch64.so.1 0755 0 0
file /omamobile/lib/libz.so.1 $(readlink -f "$x/usr/lib/libz.so.1") 0644 0 0
file /omamobile/lib/liblzma.so.5 $lzma 0644 0 0
file /omamobile/lib/libzstd.so.1 $zstd 0644 0 0
file /omamobile/Image $STAGE2_IMAGE 0644 0 0
file /omamobile/dodge.dtb $work/dodge.dtb 0644 0 0
file /omamobile/initrd $STAGE2_INITRD 0644 0 0
file /omamobile/cmdline $work/cmdline 0644 0 0
EOF

  say "Stage 1 kernel in $CHAIN_OUT"
  cp "$STAGE2_OUT/.config" "$CHAIN_OUT/.config"
  "$KERNEL_DIR/scripts/config" --file "$CHAIN_OUT/.config" \
    --set-str INITRAMFS_SOURCE "$work/list" \
    --disable INITRAMFS_COMPRESSION_GZIP --enable INITRAMFS_COMPRESSION_ZSTD \
    --set-str CMDLINE "$STAGE1_CMDLINE" --enable CMDLINE_FORCE
  make -s -C "$KERNEL_DIR" O="$CHAIN_OUT" ARCH=arm64 LLVM=1 olddefconfig
  make -s -C "$KERNEL_DIR" O="$CHAIN_OUT" ARCH=arm64 LLVM=1 -j"$JOBS" Image
  local out="$CHAIN_OUT/images/boot-chain.img"
  mkbootimg --header_version 4 --kernel "$CHAIN_OUT/arch/arm64/boot/Image" -o "$out"
  say "Packed $out"
  sha256sum "$out"
  ls -l "$out"
}

usb_ids() {
  local d
  for d in /sys/bus/usb/devices/*; do
    [[ -f $d/idVendor ]] && echo "$(<"$d/idVendor"):$(<"$d/idProduct")"
  done | grep -E '^(18d1|22d9|1d6b:0104)' | tr '\n' ' ' || true
}

cmd_boot() {
  local n
  n=$(fastboot devices 2>/dev/null | awk 'NF{c++} END{print c+0}')
  ((n == 1)) || die "want exactly one fastboot device, found $n"
  cmd_pack
  say "fastboot boot. Bands from Booting OKAY to adb: see device/dodge/chainload/README.md"
  fastboot boot "$CHAIN_OUT/images/boot-chain.img"
  local t0=$SECONDS last="" st a ip f
  while ((SECONDS - t0 < DEADLINE)); do
    f=$(fastboot devices 2>/dev/null | awk 'NF{c++} END{print c+0}')
    a=$(adb devices 2>/dev/null | awk 'NR>1 && $2=="device"{c++} END{print c+0}')
    ip=$(ip -4 -o addr 2>/dev/null | grep -c '172\.16\.42\.2' || true)
    st="fastboot=$f adb=$a usb=[$(usb_ids)] laptop-ip=$ip"
    if [[ $st != "$last" ]]; then
      echo "t=$((SECONDS - t0))s $(date +%T) $st"
      last=$st
    fi
    if ((ip > 0)) && ssh -o ConnectTimeout=2 -o BatchMode=yes -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR root@172.16.42.1 true 2>/dev/null; then
      say "t=$((SECONDS - t0))s SSH is up: ssh root@172.16.42.1"
      return 0
    fi
    ((a == 1)) && { say "t=$((SECONDS - t0))s OxygenOS is back on adb"; return 0; }
    sleep 1
  done
  say "nothing after ${DEADLINE}s. Ask the human: Power held about 30 s."
  exit 1
}

case "${1:-}" in
  pack) cmd_pack ;;
  boot) cmd_boot ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
